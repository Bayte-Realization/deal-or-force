// What the works cost, how long they take, and what they give back.
//
// capacity_gain is construction capacity, the speed every site of the country works at
// (diminishing returns above 1). A building's GDP is what it makes and sells; there is no
// GDP field.
{
  // Cheap docks and railways make the world trade freely, because reach is the ceiling on
  // how much of its shortfall a country can physically bring in.
  "Port": {
    "cost": 1.10,
    "days": 150,
    "description": "Cheap docks. The world trades freely."
  },
  "RailNetwork": {
    "cost": 1.30,
    "days": 160
  },

  // And an expensive electronics plant, so that the countries which already have one keep
  // the advantage for longer.
  "ElectronicsPlant": {
    "cost": 4.20,
    "days": 380
  }
}
