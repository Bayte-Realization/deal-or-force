<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DealOrForce</RootNamespace>
    <AssemblyName>DealOrForce</AssemblyName>
    <!--
      `build/` is the exported game, and the exported game now carries the mod templates -
      which are C# - so the SDK's `**/*.cs` glob found them and tried to compile the build
      into the thing that produced it. Excluding the folder from every default glob at once
      is the honest fix; a `Compile Remove` would leave Content and None still pointing at
      several hundred megabytes of output.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build\**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    The editor plays the Debug build, and Debug means the optimiser is switched off. For a
    game whose main loop is a simulation of a hundred and forty wars across thirty-eight
    thousand provinces, that is not a detail: the same campaign day measured 7.8 ms in an
    optimised build and 13 ms without, before the editor's own debugger is even attached.
    The person playing from the editor is the person who has to live with it, so the
    optimiser stays on in Debug too. Symbols and line numbers are kept, which is what a
    stack trace actually needs; what is lost is the guarantee that every local survives to
    be inspected in a step-through, and that is a fair price.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <!-- Mod source projects live below mods but are compiled into their own DLLs. -->
  <ItemGroup>
    <Compile Remove="mods\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Content Include="game\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      Every other picture the sprite catalogue will accept.

      It builds its index by walking this folder on disk rather than by asking the engine,
      so a picture that is not copied here does not exist as far as the game is concerned -
      whatever the .pck contains. That is how thirteen ideology icons, added as SVG, were
      visible in the editor and absent from the build: the catalogue never saw them, so
      nothing could ask for them. The list matches SpriteCatalog.PictureExtensions.
    -->
    <Content Include="game\**\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.jpeg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.webp" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.bmp" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.tga" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      And the sounds, for the same reason: the cue files name them by path and a mod's own
      recordings have to be real files beside the game.
    -->
    <Content Include="game\**\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.ogg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.map" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      `dlc/` used to be published here, and is not any more. A content pack is paid content and
      the first public alpha is free, so shipping one inactive would hand every player both the
      content and the entitlements.json that switches it on - a paywall with the key taped to
      it. In the editor the loader still reads `dlc/` out of the project itself, so nothing
      about developing a pack changes; only the build stops carrying one. Tools\build.ps1
      sweeps up any copy that reappears and fails the build if one does.

      `mods/` is deliberately not here either, for a different reason. It is the one folder a
      player writes into, so the build script puts it beside the executable where it can be
      found, rather than a level down among the data.
    -->
  </ItemGroup>
</Project>
