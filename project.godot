; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[GD-Sync]

version="1.0.2"

[addons]

curved_lines_2d/fill_in_parent_shape_with_brush=false

[application]

config/name="Deal or Force"
config/version="0.3.0.3"
run/main_scene="res://Scenes/MainMenu.tscn"
config/project_settings_override="user://graphics_override.cfg"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon_small.png"

[autoload]

BootGuard="*res://Scripts/Boot/boot_guard.gd"
_fennara_game_capture="*res://addons/fennara/runtime/game_capture_helper.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
Ezcha="*res://addons/ezcha_network/lib/singleton.gd"
LitManager="*res://addons/lit/runtime/lit_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dialogue_manager]

runtime/advanced/uses_dotnet=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DealOrForce"

[editor_plugins]

enabled=PackedStringArray("res://Tools/EditorCompatibility/Ziva/plugin.cfg", "res://addons/GD-Sync/plugin.cfg", "res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/curved_lines_2d/plugin.cfg", "res://addons/ezcha_network/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/lit/plugin.cfg", "res://addons/orca/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/d3d12/max_resource_descriptors=131072.0
textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"

[shader_globals]

lit_light_data={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_light_count={
"type": "int",
"value": 0
}
lit_viewport_size={
"type": "vec2",
"value": Vector2(0, 0)
}
lit_canvas_scale={
"type": "float",
"value": 1.0
}
lit_world_sdf={
"filter": "linear",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_wsdf_basis={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_wsdf_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
lit_ambient_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
lit_ambient_energy={
"type": "float",
"value": 1.0
}
lit_shadow_steps_max={
"type": "int",
"value": 64
}
lit_shadow_step_scaling={
"type": "bool",
"value": false
}
lit_tile_size={
"type": "int",
"value": 64
}
lit_tile_grid={
"type": "ivec2",
"value": Vector2i(0, 0)
}
lit_directional_count={
"type": "int",
"value": 0
}
lit_lighting_model={
"type": "int",
"value": 0
}
lit_tile_headers={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_tile_indices={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_cookie_atlas={
"filter": "linear",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_ysort_enabled={
"type": "bool",
"value": false
}
lit_ysort_band={
"type": "float",
"value": 12.0
}
lit_occ_data={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_occ_headers={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_occ_indices={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_gx_count={
"type": "int",
"value": 0
}
lit_gx_rect0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_count={
"type": "int",
"value": 0
}
lit_ramp_rect0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_rect1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_rect2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_rect3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}

[window]

energy_saving/render_when_hidden=true
