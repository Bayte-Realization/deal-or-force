# --- Godot ---
.godot/
/android/

# --- .NET build output ---
# /build/ is where Tools\build.ps1 leaves the exported game and its archive: hundreds of
# megabytes rebuilt from source in five minutes, which have no business in history. This
# line was missing at first, so staging a commit meant deleting the folder by hand - and
# twice that threw away the archive that was about to be sent to somebody.
/build/
bin/
obj/
*.user
*.swp

# --- Editor / AI tooling (local dev tools, not part of the game) ---
# addons/ holds third-party editor plugins (~1.6 GB) that are installed
# per-machine, not shipped with the project. See README -> "Установка".
addons/
.fennara/
.vs/
.vscode/
.idea/

# --- Third-party demo content shipped with an addon, unused by the game ---
demo/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
perf.log
/Deal or Force Launcher.exe
/Tools/TerrainCompiler/cache/
# Local plans and assistant harnesses are deliberately not published.
/PLAN.md
/ПЛАН_CLAUDE.md
/.cursor/
/.devin/

