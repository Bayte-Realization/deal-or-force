# --- Godot ---
.godot/
/android/

# --- .NET build output ---
# /build/ is where Tools\build.ps1 leaves the exported game and its archive: hundreds of
# megabytes rebuilt from source in five minutes, which have no business in history. This
# line was missing at first, so staging a commit meant deleting the folder by hand - and
# twice that threw away the archive that was about to be sent to somebody.
/build/
bin/
obj/
*.user
*.swp

# --- Editor / AI tooling (local dev tools, not part of the game) ---
# addons/ holds third-party editor plugins (~1.6 GB) that are installed
# per-machine, not shipped with the project. See README -> "Установка".
addons/
.fennara/
.vs/
.vscode/
.idea/

# --- Third-party demo content shipped with an addon, unused by the game ---
demo/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
perf.log
# Bench output. A run writes tens of kilobytes of world state that is only ever read
# once, on the day it was produced - it belongs in a scratch folder, not in history.
/simbench*.log
/bench*.log
/Deal or Force Launcher.exe
/Tools/TerrainCompiler/cache/
/Tools/CityCompiler/cache/

# Concept art and logo masters. Working material rather than game content - nothing under
# game/ or Scripts/ reads any of it, and the game's own logo lives in game/gfx/interface/brand.
# Kept on disk, out of the repository.
/art/

# Press and marketing material: the showcase plan, the Bayte Atlas typeface and the shots cut
# for it. The author's own working material - nobody cloning the game needs a video script,
# and no line of the game reads any of it. Same treatment as /art/: kept on disk, not shipped.
/press/

# Content packs are content somebody sells, not source: the framework ships, packs do not.
# Only the pack folders - dlc/README.md and dlc/entitlements.json stay in the repository.
/dlc/*/
