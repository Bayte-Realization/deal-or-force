<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DealOrForce.Rules</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.402" />
    <Compile Include="AssaultRules.fs" />
    <Compile Include="CatalogueWindow.fs" />
    <Compile Include="WarScoreRules.fs" />
    <Compile Include="PeaceRules.fs" />
  </ItemGroup>
</Project>
