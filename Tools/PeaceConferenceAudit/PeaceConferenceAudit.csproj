<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <CodePage>65001</CodePage>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <!-- Reuse the engine-neutral test assembly, not the running Godot project.
       Set the CLI artifacts-path option so references also use isolated outputs. -->
  <ItemGroup>
    <ProjectReference Include="../FormableTests/FormableTests.csproj" />
  </ItemGroup>
</Project>
