<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Scripts/Simulation/**/*.cs"/>
    <!-- The mod contracts (CrossoverVoxel and friends) live beside the mod loader, not under
         Simulation, and the simulation layer writes them: a mod type the harness cannot see is
         a harness that compiles nothing at all. -->
    <Compile Include="../../Scripts/Modding/ModContracts.cs"/>
    <Compile Include="../../Scripts/Modding/ModOperations.cs"/>
  </ItemGroup>
  <Import Project="../../Scripts/Simulation/StructuredData.Dependencies.props" />
</Project>
