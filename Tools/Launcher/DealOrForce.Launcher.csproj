<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../GameVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deal or Force Launcher</AssemblyName>
    <ApplicationIcon>../../icon.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Scripts/Modding/ContentSelection.cs" Link="ContentSelection.cs" />
    <Compile Include="../../Scripts/Simulation/GameBuildInfo.cs" Link="GameBuildInfo.cs" />
    <Compile Include="../../Scripts/Simulation/GameFolders.cs" Link="GameFolders.cs" />
    <Compile Include="../../Scripts/Simulation/SupportReport.cs" Link="SupportReport.cs" />
    <!-- The planet of the main menu (0.6.6): the launcher opens on the same picture the game does. -->
    <Resource Include="../../game/gfx/interface/brand/menu_world.png" Link="Art/menu_world.png" />
    <Resource Include="../../game/gfx/interface/brand_logo_banner.png" Link="Brand.png" />
    <Resource Include="../../icon.ico" Link="App.ico" />
  </ItemGroup>
</Project>
