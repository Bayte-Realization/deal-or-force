<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../GameVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deal or Force Launcher</AssemblyName>
    <ApplicationIcon>../../icon.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Scripts/Modding/ContentSelection.cs" Link="ContentSelection.cs" />
    <Compile Include="../../Scripts/Simulation/GameBuildInfo.cs" Link="GameBuildInfo.cs" />
    <Compile Include="../../Scripts/Simulation/GameFolders.cs" Link="GameFolders.cs" />
    <Resource Include="../../game/gfx/loading/loading_war_room.jpg" Link="Art/loading_war_room.jpg" />
    <Resource Include="../../game/gfx/loading/loading_negotiation_hall.jpg" Link="Art/loading_negotiation_hall.jpg" />
    <Resource Include="../../game/gfx/loading/loading_port_dusk.jpg" Link="Art/loading_port_dusk.jpg" />
    <Resource Include="../../game/gfx/loading/loading_winter_front.jpg" Link="Art/loading_winter_front.jpg" />
    <Resource Include="../../game/gfx/interface/brand_logo_banner.png" Link="Brand.png" />
    <Resource Include="../../icon.ico" Link="App.ico" />
  </ItemGroup>
</Project>
