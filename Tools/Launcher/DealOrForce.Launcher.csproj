<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../GameVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Deal or Force Launcher</AssemblyName>
    <ApplicationIcon>../../icon.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
    <PackageReference Include="ZLinq" Version="1.6.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Scripts/Modding/ContentSelection.cs" Link="ContentSelection.cs" />
    <Compile Include="../../Scripts/Simulation/GameBuildInfo.cs" Link="GameBuildInfo.cs" />
    <Compile Include="../../Scripts/Simulation/GameFolders.cs" Link="GameFolders.cs" />
    <Compile Include="../../Scripts/Simulation/RecyclableStreams.cs" Link="RecyclableStreams.cs" />
    <Compile Include="../../Scripts/Simulation/SupportReport.cs" Link="SupportReport.cs" />
    <!-- The planet of the main menu (0.6.6): the launcher opens on the same picture the game does. -->
    <Resource Include="../../game/gfx/interface/brand/menu_world.png" Link="Art/menu_world.png" />
    <Resource Include="../../game/gfx/interface/brand_logo_banner.png" Link="Brand.png" />
    <Resource Include="../../icon.ico" Link="App.ico" />
  </ItemGroup>
</Project>
