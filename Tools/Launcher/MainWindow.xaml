<Window x:Class="DealOrForce.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DealOrForce.Launcher"
 Title="Deal or Force — Launcher" Width="1180" Height="760" MinWidth="980" MinHeight="660"
 WindowStartupLocation="CenterScreen" Background="#0C1720" Foreground="#EAE7DE"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Icon="App.ico">
 <!--
   The launcher wears the game's own clothes (2026-10-21): the ink ground and gold rules of the
   loading screen, one of its illustrations behind the logo, and PLAY where the eye lands - under
   the picture, not in a corner. The content manager on the right is the same one as before.
 -->
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#0C1720"/>
  <SolidColorBrush x:Key="Panel" Color="#13222D"/>
  <SolidColorBrush x:Key="Rule" Color="#695E44"/>
  <SolidColorBrush x:Key="Gold" Color="#C9AE6C"/>
  <SolidColorBrush x:Key="Soft" Color="#A9B8BD"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1C2E3A"/><Setter Property="Foreground" Value="#EAE7DE"/>
   <Setter Property="BorderBrush" Value="#4A5A62"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D1B776"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F5D895"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#D1B776"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <!-- A thin ink scroll bar instead of the light system one; only the vertical kind is ever shown. -->
  <Style TargetType="ScrollBar">
   <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
    <Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#3E505A" CornerRadius="4" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </ControlTemplate></Setter.Value></Setter>
   </Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#EAE7DE"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#EAE7DE"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" BorderBrush="#2C3D48" Background="#15252F" BorderThickness="1" CornerRadius="2"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#C9AE6C"/><Setter TargetName="Row" Property="Background" Value="#1D3040"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#7F8F8E"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- The picture, the name and the button. -->
  <Grid ClipToBounds="True">
   <Image x:Name="KeyArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Rectangle>
    <Rectangle.Fill>
     <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#990C1720" Offset="0"/>
      <GradientStop Color="#550C1720" Offset="0.32"/>
      <GradientStop Color="#D90C1720" Offset="0.62"/>
      <GradientStop Color="#FA0C1720" Offset="1"/>
     </LinearGradientBrush>
    </Rectangle.Fill>
   </Rectangle>
   <Rectangle HorizontalAlignment="Right" Width="1" Fill="{StaticResource Rule}"/>
   <Grid Margin="30,28,30,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <DockPanel>
      <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="8,2" VerticalAlignment="Center" Background="#B30C1720">
       <TextBlock x:Name="VersionChip" FontSize="11" Foreground="#E3CC8E"/>
      </Border>
      <TextBlock Text="DEAL OR FORCE  /  LAUNCH CENTRE" FontSize="11" Foreground="#CCB77E" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Background="#EFE8D8" Padding="0,20" Margin="0,22,0,0" BorderBrush="#B19A60" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
      <Image Source="Brand.png" Stretch="Uniform" Height="96"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,18">
     <TextBlock Text="THE WORLD WILL NOT WAIT." FontSize="27" FontFamily="Georgia" Foreground="#F1EAD8"/>
     <Rectangle Height="2" Fill="#B19A60" Margin="0,12,150,14" HorizontalAlignment="Stretch"/>
     <TextBlock Text="Strike a deal. Or force one." FontSize="16" Foreground="#E4DCC8" Margin="0,0,0,8"/>
     <TextBlock Text="Prepare your version of the world: choose the expansions, set up your mods and begin a campaign." Foreground="{StaticResource Soft}" LineHeight="22"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="BASE GAME" FontSize="10" Foreground="#8EA0A9"/><TextBlock x:Name="BaseCount" Text="1" FontSize="22" Foreground="#F1EAD8" FontFamily="Bahnschrift"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="EXPANSIONS" FontSize="10" Foreground="#8EA0A9"/><TextBlock x:Name="DlcCount" FontSize="22" Foreground="#F1EAD8" FontFamily="Bahnschrift"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="MODS" FontSize="10" Foreground="#8EA0A9"/><TextBlock x:Name="ModCount" FontSize="22" Foreground="#F1EAD8" FontFamily="Bahnschrift"/></StackPanel>
      </Grid>
     </Border>
     <Button x:Name="Play" Content="PLAY  ▶" Click="PlayClick" Height="62" Background="#B39A5C" Foreground="#101A22" BorderBrush="#E2CB92" FontSize="20" FontWeight="Bold">
      <Button.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#C9AE6C"/></Button.Effect>
     </Button>
     <TextBlock x:Name="Summary" Margin="0,10,0,0" Foreground="#CDB985" FontSize="12" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Grid>

  <!-- What the next campaign is made of. -->
  <Grid Grid.Column="1" Margin="30,26,30,22">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="132"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="EnvironmentLabel" Text="LOCAL INSTALLATION" Foreground="#8EA0A9" FontSize="11" VerticalAlignment="Center"/>
     <Button x:Name="LanguageButton" Click="LanguageClick" Margin="14,0,0,0" Padding="10,4" FontSize="11"
             ToolTip="Switch the launcher and the game between English and Russian."/>
    </StackPanel>
    <TextBlock Text="Game content" FontSize="28" FontFamily="Georgia" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Grid.Row="1" Text="Base game → DLC → mods. Dependencies load first." FontSize="12" Foreground="#8EA0A9" Margin="0,-10,0,14"/>
   <Grid Grid.Row="2" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ModsTab" Content="Mods" Click="ModsClick" Margin="0,0,6,0" MinWidth="96"/>
    <Button x:Name="DlcTab" Grid.Column="1" Content="Expansions" Click="DlcClick" Margin="0,0,14,0" MinWidth="96"/>
    <Grid Grid.Column="2">
     <TextBox x:Name="Search" Background="#0A141B" Foreground="#EAE7DE" BorderBrush="#3A4A53" Padding="10,7" TextChanged="SearchChanged" VerticalContentAlignment="Center" ToolTip="Search by name or ID" AutomationProperties.Name="Search mods and expansions" CaretBrush="#EAE7DE"/>
     <TextBlock Text="Search by name or ID…" Foreground="#7D919C" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
    <Button Grid.Column="3" Content="Refresh" Margin="10,0,0,0" Click="RefreshClick" ToolTip="Look for mods and DLC again. Changes are saved first."/>
   </Grid>
   <Grid Grid.Row="3" Margin="0,0,0,12">
    <ListBox x:Name="PackageList" Background="Transparent" BorderThickness="0" SelectionChanged="SelectionChanged"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Rectangle x:Name="Stripe" Fill="#5B6A71"/>
       <CheckBox Grid.Column="1" Margin="12,0,0,0" IsChecked="{Binding Checked, Mode=OneWay}" IsEnabled="{Binding Owned}" Tag="{Binding}" Click="ToggleClick"
        AutomationProperties.Name="{Binding Name}" ToolTip="{local:T 'Turn on or off for the next launch'}"/>
       <StackPanel Grid.Column="2" Margin="0,12,12,12">
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
         <TextBlock x:Name="State" Text="{Binding Status}" Foreground="#9FB0B7" FontSize="12"/>
         <Border x:Name="CodeChip" Visibility="Collapsed" Margin="10,0,0,0" Padding="6,0" BorderBrush="#B86A4E" BorderThickness="1" CornerRadius="2">
          <TextBlock Text="{local:T 'code'}" FontSize="11" Foreground="#E09474"/>
         </Border>
        </StackPanel>
       </StackPanel>
       <TextBlock Grid.Column="3" Text="{Binding Version}" Foreground="#CBB77D" FontSize="12" Margin="0,12,14,0" VerticalAlignment="Top"/>
      </Grid>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding Kind}" Value="ready"><Setter TargetName="Stripe" Property="Fill" Value="#6FA37A"/><Setter TargetName="State" Property="Foreground" Value="#9CC9A4"/></DataTrigger>
       <DataTrigger Binding="{Binding Kind}" Value="problem"><Setter TargetName="Stripe" Property="Fill" Value="#C0624B"/><Setter TargetName="State" Property="Foreground" Value="#E8957F"/></DataTrigger>
       <DataTrigger Binding="{Binding Kind}" Value="locked"><Setter TargetName="Stripe" Property="Fill" Value="#3B4A52"/><Setter TargetName="State" Property="Foreground" Value="#7D8E96"/></DataTrigger>
       <DataTrigger Binding="{Binding HasCode}" Value="True"><Setter TargetName="CodeChip" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyMessage" Text="No mods installed yet.&#10;&#10;Add a mod folder with a manifest.json to mods, then press &quot;Refresh&quot;.&#10;&#10;_templates holds examples for authors; they are not active mods." Foreground="#A6B7C0" LineHeight="24" Margin="14,20" IsHitTestVisible="False"/>
   </Grid>
   <Border Grid.Row="4" Background="#0A141B" BorderBrush="#2E3E48" BorderThickness="1" Padding="14" Margin="0,0,0,12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="Details" Foreground="#B7C5CC" FontSize="12" LineHeight="21" Text="Choose a mod or expansion to see its description, dependencies and where its files are."/>
    </ScrollViewer>
   </Border>
   <DockPanel Grid.Row="5">
    <Button DockPanel.Dock="Right" Content="Save" Click="SaveClick" MinWidth="110"/>
    <WrapPanel>
     <Button Content="Open folder" Click="OpenPackageFolder" Margin="0,0,8,0"/>
     <Button x:Name="Earlier" Content="↑ Earlier" Click="EarlierClick" Margin="0,0,8,0" ToolTip="Mod load order. Required dependencies always come first."/>
     <Button x:Name="Later" Content="↓ Later" Click="LaterClick"/>
    </WrapPanel>
   </DockPanel>
   <Border Grid.Row="6" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
      <Button Content="Logs and settings" Click="OpenProfile" Style="{StaticResource Link}"/>
      <Button x:Name="EngineButton" Content="  /  Choose Godot .NET" Click="ChooseEngine" Style="{StaticResource Link}"/>
     </WrapPanel>
     <TextBlock x:Name="Status" Text="Settings take effect when the game starts." FontSize="12" Foreground="#B4C4CB" VerticalAlignment="Center" Margin="0,0,16,0"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
