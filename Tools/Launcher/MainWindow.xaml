<Window x:Class="DealOrForce.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Deal or Force — Лаунчер" Width="1080" Height="750" MinWidth="900" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#101D28" Foreground="#EAE7DE"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Icon="App.ico">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#213340"/><Setter Property="Foreground" Value="#EAE7DE"/>
   <Setter Property="BorderBrush" Value="#53616A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D1B776"/><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F5D895"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#EAE7DE"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#EAE7DE"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" BorderBrush="#334653" Background="#1A2B37" BorderThickness="1" CornerRadius="3"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D1B776"/><Setter TargetName="Row" Property="Background" Value="#253541"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#879694"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <TextBlock Text="DEAL OR FORCE  /  ЦЕНТР ЗАПУСКА" FontSize="12" Foreground="#CCB77E" VerticalAlignment="Center"/>
   <TextBlock x:Name="EnvironmentLabel" Text="ЛОКАЛЬНАЯ УСТАНОВКА" HorizontalAlignment="Right" Foreground="#90A5B0" FontSize="11"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#182934" BorderBrush="#41525B" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="#EFE8D8" Padding="0,32"><Image Source="Brand.png" Stretch="Uniform"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,24,22,12">
       <TextBlock Text="МИР НЕ ЖДЁТ." FontSize="25" FontFamily="Georgia" Foreground="#EAE2CF"/>
       <Rectangle Height="2" Fill="#B19A60" Margin="0,16,100,18"/>
       <TextBlock Text="Договорись. Или заставь." FontSize="16" Margin="0,0,0,12"/>
       <TextBlock Text="Подготовьте свою версию мира: выберите дополнения, настройте моды и начните кампанию." Foreground="#A9B8BD" LineHeight="23"/>
       <TextBlock x:Name="Summary" Margin="0,26,0,0" Foreground="#D5C18C" FontSize="13"/>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="#354751" BorderThickness="0,1,0,0" Padding="22,16">
      <TextBlock Text="Базовая игра → DLC → моды&#10;Зависимости загружаются первыми." FontSize="12" Foreground="#99ADB6" LineHeight="21"/>
     </Border>
    </Grid>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
     <RowDefinition Height="145"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
     <TextBlock Text="Состав игры" FontSize="27" FontWeight="SemiBold"/>
     <Button Content="Обновить" HorizontalAlignment="Right" Click="RefreshClick" ToolTip="Повторно найти моды и DLC. Изменения сначала сохраняются."/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="ModsTab" Content="Моды" Click="ModsClick" Margin="0,0,8,0"/>
     <Button x:Name="DlcTab" Grid.Column="1" Content="Дополнения" Click="DlcClick" Margin="0,0,14,0"/>
     <Grid Grid.Column="2">
      <TextBox x:Name="Search" Background="#0D1821" Foreground="#EAE7DE" BorderBrush="#41525B" Padding="10,8" TextChanged="SearchChanged" VerticalContentAlignment="Center" ToolTip="Поиск по названию или ID" AutomationProperties.Name="Поиск модов и дополнений"/>
      <TextBlock Text="Поиск по названию или ID…" Foreground="#8399A6" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12">
     <ListBox x:Name="PackageList" Background="Transparent" BorderThickness="0" SelectionChanged="SelectionChanged"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="13,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding Checked, Mode=OneWay}" IsEnabled="{Binding Owned}" Tag="{Binding}" Click="ToggleClick"
         AutomationProperties.Name="{Binding Name}" ToolTip="Включить / выключить при следующем запуске"/>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
         <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Status}" Foreground="#B8C5CA" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Version}" Foreground="#CBB77D" FontSize="12" VerticalAlignment="Top"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyMessage" Text="Моды пока не установлены.&#10;&#10;Добавьте папку мода с manifest.json в mods и нажмите «Обновить».&#10;Папка _templates содержит примеры для авторов — они не включаются автоматически." Foreground="#A6B7C0" LineHeight="24" Margin="14,20" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="3" Background="#0D1821" BorderBrush="#354751" BorderThickness="1" Padding="14" Margin="0,0,0,12">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="Details" Foreground="#B7C5CC" FontSize="12" LineHeight="21" Text="Выберите мод или дополнение, чтобы посмотреть описание, зависимости и расположение файлов."/>
     </ScrollViewer>
    </Border>
    <WrapPanel Grid.Row="4">
     <Button Content="Открыть папку" Click="OpenPackageFolder" Margin="0,0,8,0"/>
     <Button x:Name="Earlier" Content="↑ Раньше" Click="EarlierClick" Margin="0,0,8,0" ToolTip="Порядок загрузки модов. Обязательные зависимости всегда первыми."/>
     <Button x:Name="Later" Content="↓ Позже" Click="LaterClick"/>
    </WrapPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#40505A" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
     <TextBlock x:Name="Status" Text="Настройки применяются при запуске игры." FontSize="12" Foreground="#B4C4CB"/>
     <WrapPanel Margin="0,7,0,0">
      <Button Content="Логи и настройки" Click="OpenProfile" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#D1B776" FontSize="12"/>
      <Button x:Name="EngineButton" Content="  /  Выбрать Godot .NET" Click="ChooseEngine" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#D1B776" FontSize="12"/>
     </WrapPanel>
    </StackPanel>
    <Button Grid.Column="1" Content="Сохранить" Click="SaveClick" Margin="0,0,12,0"/>
    <Button x:Name="Play" Grid.Column="2" Content="ИГРАТЬ  ▶" Click="PlayClick" Width="190" Height="55" Background="#AE955A" Foreground="#121E27" BorderBrush="#D6C08B" FontSize="18" FontWeight="Bold"/>
   </Grid>
  </Border>
 </Grid>
</Window>
