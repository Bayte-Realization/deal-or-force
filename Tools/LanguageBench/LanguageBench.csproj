<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Second languages against C#, measured on three kernels of different shapes: a raster
    (FrontierField), a graph (the ownership BFS of Tools/GodotLanguages/kernels/ownership) and
    per-country arithmetic (BudgetCore.Evaluate). The C# reference for each is the game's own
    code, compiled from Scripts/Simulation exactly as SimBench and OwnershipKernelBench do; the
    other contenders are line-by-line ports, loaded in-process (F#) or through a C ABI (Rust,
    Zig, Odin, Nim), plus Luau through its real out-of-process worker. See README.md.

    Same collector as SimBench and the shipping game (server GC), so a pause that the frontier
    field's 170 MB of scratch causes here is one the player would see as well.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>DealOrForce.Tools.LanguageBench</RootNamespace>
    <AssemblyName>LanguageBench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSharedCompilation>false</UseSharedCompilation>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Scripts/Simulation/**/*.cs" />
    <Compile Include="../../Scripts/Modding/ModOperations.cs" />
    <Compile Include="../../Scripts/Modding/ModContracts.cs" />
    <!-- The ownership kernel's existing managed host and CSR reference, reused unchanged. -->
    <Compile Include="../GodotLanguages/kernels/ownership/managed/*.cs" />
    <Compile Remove="fsharp/**" />
    <Compile Remove="native/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="fsharp/LanguageBench.FSharp.fsproj" />
  </ItemGroup>

  <Import Project="../../Scripts/Simulation/StructuredData.Dependencies.props" />
</Project>
