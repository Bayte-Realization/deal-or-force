<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless harness for the campaign simulation. The project's own performance contract
    says "full campaign tick and pure systems must be runnable outside a Godot Node" -
    this is that claim made executable: it compiles Scripts/Simulation and reads external
    world-map data, with no Godot reference at all. If someone ever imports Godot
    into the simulation layer, this project stops compiling, which is the point.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>DealOrForce.Tools</RootNamespace>
    <AssemblyName>SimBench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Scripts\Simulation\**\*.cs" />
    <Compile Include="..\..\Scripts\Modding\ModOperations.cs" />
    <Compile Include="..\..\Scripts\Modding\ModContracts.cs" />
  </ItemGroup>

  <Import Project="../../Scripts/Simulation/StructuredData.Dependencies.props" />
</Project>
