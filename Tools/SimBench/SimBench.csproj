<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless harness for the campaign simulation. The project's own performance contract
    says "full campaign tick and pure systems must be runnable outside a Godot Node" -
    this is that claim made executable: it compiles Scripts/Simulation and reads external
    world-map data, with no Godot reference at all. If someone ever imports Godot
    into the simulation layer, this project stops compiling, which is the point.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>DealOrForce.Tools</RootNamespace>
    <AssemblyName>SimBench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The shipping game runs server GC with a 4 GiB hard limit (DealOrForce.csproj and
      runtimeconfig.template.json). A bench built without them collects on the workstation
      collector, so every pause it reports is a pause the player never sees - and the runs that
      sized the game's GC only matched it by remembering DOTNET_gcServer=1 at the command line.
      Same collector here, so a number from the bench means the same thing as a number from the
      game. FormableTests deliberately does the opposite: it is a test host and wants cheap,
      short-lived runs.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ArmyOrderObservation.cs" />
    <Compile Include="..\..\Scripts\Simulation\**\*.cs" />
    <Compile Include="..\..\Scripts\Modding\ModOperations.cs" />
    <Compile Include="..\..\Scripts\Modding\ModContracts.cs" />
  </ItemGroup>

  <Import Project="../../Scripts/Simulation/StructuredData.Dependencies.props" />
</Project>
