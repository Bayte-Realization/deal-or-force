{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dealorforce.local/schemas/patch.schema.json",
  "title": "Deal or Force Declarative JSON Patch",
  "description": "Stackable patches/*.json file modifying base-game or mod data records across 3 startup stages (base -> updates -> final_fixes) without forking whole files.",
  "definitions": {
    "modGate": {
      "description": "Only execute when all listed mod IDs are enabled.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 } },
        {
          "type": "object",
          "required": ["mods"],
          "properties": {
            "mods": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["set", "replace", "add", "multiply", "append", "remove", "conditional"],
          "description": "Patch operation kind."
        },
        "target": {
          "type": "string",
          "description": "Top-level record ID in the category document (omit for root-level files such as common/defines)."
        },
        "path": {
          "type": "string",
          "description": "Dot-separated field path inside the target record (supports array indexes like 'options[0].effects.stability')."
        },
        "value": {
          "description": "Value to set, replace, add (number), multiply (number), append, or match when removing from an array."
        },
        "unique": {
          "type": "boolean",
          "default": false,
          "description": "For 'append': skip inserting duplicates already present in the array."
        },
        "flatten": {
          "type": "boolean",
          "default": false,
          "description": "For 'append': when value is an array, append each element individually."
        },
        "create_target": {
          "type": "boolean",
          "default": false,
          "description": "For 'set': create the target record object if it does not yet exist."
        },
        "if_exists": {
          "type": "string",
          "description": "For 'conditional': dot-separated path checked for non-null existence relative to target."
        },
        "then": {
          "type": "array",
          "items": { "$ref": "#/definitions/operation" },
          "description": "Operations run when 'if_exists' is true."
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/definitions/operation" },
          "description": "Operations run when 'if_exists' is false."
        },
        "if_mod_loaded": { "$ref": "#/definitions/modGate" }
      }
    },
    "patchBlock": {
      "type": "object",
      "required": ["category", "operations"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["base", "updates", "final_fixes"],
          "default": "updates",
          "description": "Startup pass order across all enabled mods: base -> updates -> final_fixes."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Virtual data folder to patch (e.g. 'common/technologies', 'common/defines', 'common/decisions', 'events', 'common/units')."
        },
        "file": {
          "type": "string",
          "description": "Optional filename filter (e.g. '00_technologies.json'). Omit to target all files in the category."
        },
        "if_mod_loaded": { "$ref": "#/definitions/modGate" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/operation" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/patchBlock" },
    {
      "type": "object",
      "required": ["patches"],
      "properties": {
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/patchBlock" }
        }
      }
    },
    {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/patchBlock" }
    }
  ],
  "defaultSnippets": [
    {
      "label": "Stackable Balance Patch Block",
      "description": "Scale a field and conditionally add a bonus",
      "body": {
        "stage": "${1|base,updates,final_fixes|}",
        "category": "${2:common/technologies}",
        "operations": [
          {
            "op": "multiply",
            "target": "${3:record_id}",
            "path": "${4:cost}",
            "value": 1.15
          },
          {
            "op": "conditional",
            "target": "${3:record_id}",
            "if_exists": "effects.research_speed",
            "then": [
              { "op": "add", "path": "effects.research_speed", "value": 0.05 }
            ],
            "else": [
              { "op": "set", "path": "effects.research_speed", "value": 0.05 }
            ]
          }
        ]
      }
    }
  ]
}
