{
  "layout": {
    "workshop.panel": { "anchors": [0,0,1,1], "offsets": [40,30,-40,-30] }
  },
  "metrics": {
    "map.country_font_size": 64,
    "map.country_tracking": 0.86,
    // The province line. It used to be the heaviest stroke on the map - 2 px at 85 % against a
    // country border of 1.35 px - so every country read as cracked leather and the frontier
    // drowned in its own parishes. A hairline at about a third lets the relief and the
    // country's colour carry the picture, leaves a province findable under the cursor, and
    // puts the ranks in the order the eye expects: country, region shade, province. No pale
    // shoulder: it doubled every line on light countries.
    "map.province_border_width": 1.0,
    "map.province_border_opacity": 0.36,
    "map.province_border_halo": 0.0,
    "map.city_font_size": 44,
    "map.city_text_pixels": 12.5,
    "map.city_capital_text_pixels": 13.8,
    "map.city_outline_ratio": 0.14,
    "map.city_label_limit": 140,
    // Every city is drawn alike: one dot, one lettering. A city that is a country's capital at
    // the moment has the capital's mark (and globe.city_capital for its name) instead.
    "map.city_dot_pixels": 8,
    "map.city_capital_mark_pixels": 10,
    // The zoom bands. From how far out each begins (a view distance), and how many cities are
    // lettered in it: that many from the head of map_data/cities, whose order runs from the
    // most to the least prominent place. Capitals are lettered in every band, whichever cities
    // they are today; the closest band (tier3) letters every city. The counts are how many
    // places each of the old ranks held, so the map shows what it did.
    "map.city_tier0_distance": 15.0,
    "map.city_tier1_distance": 11.0,
    "map.city_tier2_distance": 8.4,
    "map.city_tier3_distance": 6.6,
    "map.city_band0_count": 330,
    "map.city_band1_count": 1142,
    "map.city_band2_count": 2448
  }
}
