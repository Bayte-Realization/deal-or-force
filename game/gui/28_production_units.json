{
  "metrics": {
    "production.cells_per_page": 20,
    "production.grid_columns": 10,
    "production.cell_size": 28,
    "production.map_shade": 0.30,
    "production.line_gap": 8
  },
  "colors": {
    "production.card": "#172630",
    "production.border": "#374a54",
    "production.inset": "#0c151b",
    "production.empty_border": "#4d626b",
    "production.empty_icon": "#37454c",
    "production.blocked": "#252e34",
    "production.civilian": "#a5c588",
    "production.civilian_fill": "#293b2f",
    "production.military": "#dac082",
    "production.military_fill": "#443b26",
    "production.hover": "#394749",
    "production.focus": "#f5dfa2"
  },
  "layout": {
    // The production workspace.
    //
    // Its left edge used to be a share of the window (0.044) while every other workspace used
    // 0.055 - and the navigation rail it has to clear is a FIXED 82 pixels
    // (shell.navigation_size), not a share of anything. At 1920 the two almost agreed (84 px),
    // which is why it looked right where it was first checked; at 1280 the same share is 56 px
    // and the panel sat under the rail. A fixed rail wants a fixed offset: 92 px leaves it an
    // honest ten-pixel gutter at any window width, and the panel keeps its 850 px of content
    // beside it. The vertical edges now match the other workspaces as well.
    "modal.production": {
      "anchors": [0, 0.115, 0, 0.9],
      "offsets": [92, 0, 942, 0]
    }
  }
}
