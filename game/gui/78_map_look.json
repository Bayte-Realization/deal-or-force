{
  // The atlas look of the map (Simulation.MapLook): a map printed in warm inks on heavy paper and
  // lit by a desk lamp from the north-west. Close in the ground shows through the country colour
  // by its brightness; at the middle zoom the countries are flat paint with dark ink borders; from
  // far away the whole map becomes a sheet of paper. Switched by the video setting "map_look"
  // (atlas / classic); classic ignores everything in this file.
  //
  // This is the era-neutral base. Marks that belong to a period - engraved waterlines along the
  // coasts, hand-lettered cartouches, a sepia cast - are for an era's overlay, not for here.
  //
  // Colours are ordinary sRGB hex, converted to linear light for the shader. One brightness
  // order runs through them, light to dark: labels, land paper, coastal water and shelf, open
  // sea, then the inks (country border, coast, province). Accents - selection gold, front red,
  // plan blue - are not used for anything else.
  "colours": {
    // Neutral archival cotton paper (#eceae4) under country colours in paper mood and far zoom.
    "map.look_paper": "#eceae4",
    // Land no state holds (Antarctica, unclaimed regions): neutral cotton ~6% darker.
    "map.look_unowned": "#dfddd6",
    // Cool Rayleigh slate shadow hue vs crisp neutral D65 daylight highlight (zero sepia cast).
    "map.look_shade": "#4d5463",
    "map.look_lamp": "#faf9f6",
    // The sea by depth: abyss, continental slope, shelf, and shallow littoral.
    "map.look_sea_deep": "#18323f",
    "map.look_sea_mid": "#234b58",
    "map.look_sea_shelf": "#3d6b70",
    "map.look_sea_coast": "#6a9690",
    // Three-step chart sea tone from far away and in paper mood.
    "map.look_sea_chart": "#2a4450",
    // Crisp neutral surf along shores and wave crests (no yellow tint).
    "map.look_foam": "#f2f1ee",
    // Coast ink lighter and bluer than a frontier (#1c2230).
    "map.look_coast_ink": "#2e4048",
    // Crisp neutral ivory-white map typography on deep #111318 ink outline (zero yellow cast).
    "map.look_label_fill": "#f5f6f8",
    "map.look_label_outline": "#111318",
    "map.look_capital_fill": "#f8f9fb",
    "map.look_region_fill": "#eceef2",
    "map.look_river_fill": "#b4d6e4",
    "map.look_river_outline": "#0f1c26"
  },
  "metrics": {
    // Close in, how far the brightness of the ground may move the country colour: the fill runs
    // from (1 - this) on dark ground to (1 + this / 2) on light. The hue is never the ground's.
    "map.look_ground_show_near": 0.30,
    // How much of the ground the country colour covers from far away, where the countries are
    // what the map is for. Close in and at the middle zoom the terrain's own political_opacity.
    "map.look_cover_far": 0.95,
    // Country colour saturation on the paper map: a printed atlas is a little quieter than a poster.
    "map.look_saturation_far": 0.80,
    // Subtle neutral D65/slate relief hue lean (brightness stays exact grey hillshade).
    "map.look_relief_tint": 0.28,
    // How much of the relief shading survives on the paper map: mountains stay a soft wash.
    "map.look_relief_far": 0.45,
    // Where the map becomes paper: on the globe by camera distance (5.25 .. 24, default 12.5),
    // on the flat map by zoom (0.1 .. 11.5, default 8.8). It starts at the first value and is
    // complete at the second.
    "map.look_paper_from_distance": 17,
    "map.look_paper_full_distance": 22,
    "map.look_flat_paper_from_zoom": 9.0,
    "map.look_flat_paper_full_zoom": 11.5,
    // The band of deeper colour inside every frontier at the middle and far zoom, where the
    // close-in cushion has gone (as in Imperator): how deep, and how many screen pixels wide.
    // Half as deep along a coast. Nought switches it off.
    "map.look_far_band": 0.36,
    "map.look_far_band_pixels": 4.5,
    // Surf: one thin broken line along a shore, a little under a cell out, close in only.
    "map.look_foam_strength": 0.55,
    // Engraved waterlines two, three and a half and five cells off the coast. An era's mark, so
    // off in the base look; an era overlay may raise it (0.15 was the first trial).
    "map.look_waterline": 0,
    // The lamp's broad soft highlight over open sea on the globe: how much it brightens the
    // water's own colour at its centre. Not on the flat map, not on the paper map.
    "map.look_sea_sheen": 0.30,
    // How much heavier the gold outline of the picked country is drawn (1 is the classic stroke).
    "map.look_selection_width": 1.3
  }
}
