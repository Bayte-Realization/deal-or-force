// Campaign workbench: map-first docks. Later mod layout files can override each role.
{
  "layout": {
    "hud.top": { "anchors": [0,0,1,0], "offsets": [96,6,-370,80] },
    // The date plate (Scripts/ui/DatePlateUI.cs): date, slower / pause / faster, the speed marks and
    // "Menu". hud.top stops before it; on a two-row bar the second row runs on below it.
    "hud.date_plate": { "anchors": [1,0,1,0], "offsets": [-362,6,-8,80], "material": "plate" },
    "hud.navigation": { "anchors": [0,0,0,1], "offsets": [8,90,98,-60] },
    "hud.side_panel": { "anchors": [0,0,0,1], "offsets": [106,128,548,-168] },
    "hud.army_panel": { "anchors": [0,0,0,1], "offsets": [106,128,612,-168] },
    "hud.support_panel": { "anchors": [0,0,0,1], "offsets": [106,104,712,-84] },
    "hud.fleet_panel": { "anchors": [0,0,0,0], "offsets": [106,90,548,610] },
    "hud.country_card": { "anchors": [0,0,0,1], "offsets": [106,128,548,-168] },
    "hud.region_card": { "anchors": [0,1,1,1], "offsets": [552,-262,-8,-8] },
    "hud.map_controls": { "anchors": [1,1,1,1], "offsets": [-720,-74,-8,-30] },
    // The alert list (Scripts/ui/CampaignAlertsUI.cs): always visible under the date plate and as
    // wide as it, as tall as its rows (the bottom here is the height of a full list). The report
    // below docks under whatever height the list has today; these offsets are where it stands
    // under a full one.
    "hud.alerts": { "anchors": [1,0,1,0], "offsets": [-362,88,-8,332], "material": "plate" },
    "hud.outliner": { "anchors": [1,0,1,0], "offsets": [-316,340,-20,640] },
    "hud.hotseat": { "anchors": [0,1,0,1], "offsets": [106,-54,365,-6] },
    "hud.network": { "anchors": [0,1,0,1], "offsets": [106,-54,425,-6] }
  },
  "metrics": {
    // Each of the five speed marks on the date plate, in pixels (they rise to about twice that).
    "hud.speed_pips": 11,
    // The alert list: rows under "Next" before the rest wait behind "+N more", and a row's height.
    "hud.alerts.max_rows": 6,
    "hud.alerts.row_height": 28
  }
}
