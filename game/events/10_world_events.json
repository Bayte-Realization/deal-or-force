          "stability": 0.008,
          "war_support": 0.02
        }
      },
      {
        "title": "Print our own map",
        "consequence": "Two maps now, and an argument that outlives both governments.",
        "effects": {
          "war_support": 0.05,
          "state.radicalism": 0.012,
          "market_access": -0.02
        }
      },
      {
        "title": "Say nothing at all",
        "consequence": "A newspaper is a newspaper.",
        "effects": {
          "stability": 0.004
        }
      }
    ]
  },

  // Events that bring a national spirit with them.
