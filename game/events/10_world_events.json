// Deal or Force - things that happen to a country.
//
// A second pack beside 00_core_events.json, and nothing here needs code: the same
// effect keys, the same trigger grammar and the same magnitudes as the nine that
// shipped first. Every folder under events/ is read in file-name order, so a mod
// drops 50_my_events.json in beside these and is in the game.
//
//   trigger     min_<key> / max_<key> over anything in the scripted vocabulary,
//               plus at_war and tags. Every clause has to hold.
//   weight      relative chance once the trigger passes. A country remembers when
//               it last had each event and the draw discounts what it has just seen.
//   effects     applied when the option is taken; _percent and _mult are relative.
//   modifiers   temporary effects out of common/modifiers, with a length in days.
//
// An event with no trigger can happen to anybody. An event with one should be
// something that could only happen to a country in that situation - a budget crisis
// arriving in a solvent treasury reads as the game not knowing what is going on.
{
  "resource_find": {
    "title": "A find in the interior",
    "description": "Survey teams confirm a deposit large enough to be worth an argument about. Every ministry has a view on who should dig it.",
    "weight": 1.2,
    "options": [
      {
        "title": "Develop it with state money",
        "consequence": "Expensive now; the output is the country's own.",
        "effects": {
          "treasury_percent": -0.07,
          "gdp_percent": 0.005,
          "construction_capacity": 0.22
        },
        "modifiers": [
          {
            "id": "investment_boom",
            "days": 270
          }
        ]
      },
      {
        "title": "Auction the concessions",
        "consequence": "Cash today, and somebody else's profit tomorrow.",
        "effects": {
          "treasury_percent": 0.09,
          "gdp_percent": 0.0018,
          "state.radicalism": 0.008
        }
      },
      {
        "title": "Leave it in the ground",
        "consequence": "Nothing changes, which is a decision too.",
        "effects": {
          "stability": 0.004
        }
      }
    ]
  },
