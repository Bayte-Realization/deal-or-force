    "description": "Someone who had been part of the furniture of national life for forty years has died. The streets outside are quiet in a way nobody organised.",
    "weight": 1.0,
    "options": [
      {
        "title": "A state funeral",
        "consequence": "Costs something and is worth more than it costs.",
        "effects": {
          "treasury_percent": -0.015,
          "stability": 0.014,
          "state.radicalism": -0.012
        },
        "modifiers": [
          {
            "id": "national_mourning",
            "days": 90
          }
        ]
      },
      {
        "title": "Let the family decide",
        "consequence": "Quieter, and nobody minds.",
        "effects": {
          "stability": 0.006
        },
        "modifiers": [
          {
            "id": "national_mourning",
            "days": 45
          }
        ]
      }
    ]
  },
  "border_incident": {
    "title": "Shots on the border",
    "description": "Two patrols met where neither should have been. There are dead on both sides and two capitals are waiting to see who speaks first.",
    "trigger": {
      "at_war": false
    },
    "weight": 1.3,
    "options": [
      {
        "title": "Apologise first",
        "consequence": "Unpopular at home and it ends there.",
        "effects": {
          "war_support": -0.04,
          "stability": -0.006,
          "market_access": 0.03
        }
      },
      {
        "title": "Demand an apology",
        "consequence": "Popular, and the border stays tense.",
        "effects": {
          "war_support": 0.05,
          "state.radicalism": 0.008
        }
      },
      {
        "title": "Reinforce the sector and say nothing",
        "consequence": "Expensive, quiet, and understood by everybody who matters.",
        "effects": {
          "military_spending": 0.012,
          "treasury_percent": -0.02,
          "war_support": 0.02
        }
      }
    ]
  },
  "espionage_exposed": {
    "title": "A network rolled up",
    "description": "Counter-intelligence has arrested eleven people and can prove what nine of them did. The foreign ministry has been given an hour's notice.",
    "weight": 1.1,
    "options": [
      {
        "title": "Publish everything",
        "consequence": "A diplomatic incident, and a warning that lands.",
        "effects": {
          "market_access": -0.04,
          "stability": 0.012,
          "war_support": 0.03
        }
      },
      {
        "title": "Trade them quietly",
        "consequence": "Nothing in the papers and our own people come home.",
        "effects": {
          "stability": 0.006,
          "market_access": 0.02
        }
      },
      {
        "title": "Use them",
        "consequence": "They keep reporting, and now we write it.",
        "effects": {
          "stability": 0.004,
          "productivity": 0.004,
          "state.radicalism": 0.004
        }
      }
    ]
  },
  "international_summit": {
    "title": "An invitation to the table",
    "description": "A conference is being convened about something this country has an opinion on. Attending means being bound by what is agreed.",
    "weight": 1.1,
    "options": [
      {
        "title": "Go, and sign",
        "consequence": "Access, obligations, and a seat next time.",
        "effects": {
          "market_access": 0.06,
          "tax_rate": -0.005,
          "stability": 0.006
        }
      },
      {
        "title": "Go, and sign nothing",
        "consequence": "Heard, and not held to anything.",
        "effects": {
          "market_access": 0.02
        }
      },
      {
        "title": "Stay away",
        "consequence": "A free hand, and it is agreed without us.",
        "effects": {
          "market_access": -0.04,
          "war_support": 0.02,
          "stability": 0.004
        }
      }
    ]
  },
  "sanctions_threatened": {
    "title": "A list of measures",
    "description": "Several governments have circulated a draft of what they are prepared to do, and have made sure a copy reached this capital before it was published.",
    "trigger": {
      "max_market_access": 0.97
    },
    "weight": 1.2,
    "options": [
      {
        "title": "Negotiate",
        "consequence": "Concessions now instead of losses later.",
        "effects": {
          "market_access": 0.05,
          "war_support": -0.03,
          "stability": -0.004
        }
      },
      {
        "title": "Pre-empt them",
        "consequence": "Our own restrictions, on our own terms.",
        "effects": {
          "market_access": -0.05,
          "productivity": 0.006,
          "war_support": 0.04,
          "state.radicalism": -0.006
        }
      },
      {
        "title": "Do nothing and see",
        "consequence": "Perhaps it was a draft. Perhaps it was not.",
        "effects": {
          "market_access": -0.03,
          "stability": 0.002
        }
      }
    ]
  },
  "an_old_claim": {
    "title": "A map in a newspaper",
    "description": "A neighbouring paper has printed a map with this country's border drawn where it was a century ago. The neighbouring government says it is not their map.",
    "trigger": {
      "at_war": false
    },
    "weight": 1.1,
    "options": [
      {
        "title": "Ask for a formal disavowal",
        "consequence": "They give one, grudgingly, and both sides note it.",
