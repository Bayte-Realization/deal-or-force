// Every building a region can have. `cost` is billions, `days` the build time, `gdp_gain`
// the one-off step GDP takes when it is finished (the market's measure of output replaces it
// within weeks), `capacity_gain` what it adds to construction capacity (which only speeds
// building while it is below one), and `jobs` the millions of workers one of them asks for -
// the labour MarketSystem staffs the country's plant from. What a building makes and burns is
// not here: it is its place in common/production, and the build list reads it from there.
{
  "Agriculture": {
    "name": "Agricultural complex",
    "cost": 0.45,
    "days": 120,
    "gdp_gain": 0.22,
    "capacity_gain": 0.05,
    "jobs": 0.42,
    "description": "Farms. Grow food and some fertiliser (and rubber where it grows) and employ country people. Without fertiliser part of the harvest is lost."
  },
  "CivilianIndustry": {
    "name": "Civilian industry",
