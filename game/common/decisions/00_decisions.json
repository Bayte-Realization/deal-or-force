// The buttons a government may press.
//
// A decision names what it costs, what has to be true before it may be taken, what it
// does, and how much an AI wants it. The first five carry a `kind`, which is a
// consequence compiled into the game from before decisions could be scripted; the rest
// have no kind at all and are nothing but the data below - which is what a mod writes.
//
// trigger    - a condition block; "use" pulls in common/scripted_triggers.
// effects    - a change block; "use" pulls in common/scripted_effects.
// ai_will_do - a score in common/scripted_modifiers. Without one no AI ever takes it.
{
  "economic_stimulus": {
    "name": "Economic stimulus",
    "resource_costs": {"political_points": 15},
    "description": "Fund domestic demand and industrial orders. Immediate GDP and stability, paid from the treasury.",
    "cooldown_days": 365,
    "gdp_cost_share": 0.0040,
    "kind": "EconomicStimulus",
    "ai_will_do": "ai_economic_stimulus"
  },
  "education_reform": {
    "name": "National education reform",
    "resource_costs": {"political_points": 30},
    "description": "Raise literacy and productivity; universities amplify the result over time.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.0025,
    "kind": "EducationReform",
    "ai_will_do": "ai_education_reform"
  },
  "public_health": {
    "name": "Public health campaign",
    "description": "Improve living standards and population growth throughout the country.",
    "cooldown_days": 540,
    "gdp_cost_share": 0.0018,
    "kind": "PublicHealthCampaign",
    "ai_will_do": "ai_public_health"
  },
  "anti_corruption": {
    "name": "Anti-corruption drive",
    "resource_costs": { "political_points": 30 },
    "ai_resource_reserve": { "political_points": 15 },
    "description": "Improve tax collection and state stability at a short-term administrative cost.",
    "cooldown_days": 600,
    "gdp_cost_share": 0.0012,
    "kind": "AntiCorruptionDrive",
    "effects": { "add_modifier": { "revenue_compliance_audit": 270 } },
    "ai_will_do": "ai_anti_corruption"
  },
  "emergency_mobilisation": {
    "name": "Emergency mobilisation",
    "resource_costs": { "army_experience": 8, "political_points": 20 },
    "description": "Restore frontline readiness during an active war, at a cost to stability and the economy.",
    "cooldown_days": 180,
    "gdp_cost_share": 0.0020,
    "kind": "EmergencyMobilisation",
    "ai_will_do": "ai_emergency_mobilisation"
  }
  ,

  "austerity_budget": {
    "name": "Austerity budget",
    "resource_costs": {"political_points": 20},
    "description": "Cut the state to the bone to refill the treasury. It works, and nobody thanks you for it.",
    "cooldown_days": 400,
    "gdp_cost_share": 0.0,
    "unavailable": "The treasury is not empty enough to justify it",
    "trigger": { "use": [ "empty_coffers" ] },
    "effects": { "use": [ "austerity" ] },
    "ai_will_do": "ai_austerity_budget"
  },

  "conscription_drive": {
    "name": "Conscription drive",
    "resource_costs": { "army_experience": 5, "political_points": 25 },
    "description": "Widen the call-up. Men for the front, at the price of the patience of the people sending them.",
    "cooldown_days": 240,
    "gdp_cost_share": 0.0008,
    "unavailable": "Requires a war and a shortage of men",
    "trigger": { "use": [ "short_of_men" ] },
    "effects": {
      "manpower": 180000,
      "war_support": -0.030,
      "stability": -0.018
    },
    "ai_will_do": "ai_conscription_drive"
  },

  "infrastructure_bond": {
    "name": "Infrastructure bond",
    "resource_costs": {"political_points": 10},
    "description": "Borrow against the peace to build roads, power and rail. The bill comes now; the country is richer for a decade.",
    "cooldown_days": 500,
    "gdp_cost_share": 0.0035,
    "unavailable": "Requires peace and reserves to borrow against",
    "trigger": { "use": [ "at_peace", "solvent" ] },
    "effects": { "use": [ "industrial_push" ] },
    "ai_will_do": "ai_infrastructure_bond"
  },

  "amnesty": {
    "name": "General amnesty",
    "resource_costs": {"political_points": 15},
    "description": "Empty the prisons of the politically inconvenient. Cheap, immediate, and remembered.",
    "cooldown_days": 900,
    "gdp_cost_share": 0.0002,
    "unavailable": "The country is calm enough not to need it",
    "trigger": { "use": [ "restive" ] },
    "effects": {
      "use": [ "civil_calm" ],
      "stability": 0.015,
      "state.radicalism": -0.012
    },
    "ai_will_do": "ai_amnesty"
  },

  // Decisions that hang a national spirit on the country for a while (common/modifiers):
  // "add_modifier": { "<spirit>": days }, 0 for the spirit's own length.
  "declare_general_mobilisation": {
    "name": "Declare general mobilisation",
    "resource_costs": {"political_points": 30},
    "description": "Call up every reservist and put the training grounds on shifts. Divisions are raised and refilled far faster; the factories lose the men.",
    "cooldown_days": 400,
    "gdp_cost_share": 0.003,
    "unavailable": "Only a country at war mobilises",
    "trigger": {
      "use": [
        "at_war"
      ]
    },
    "effects": {
      "add_modifier": {
        "general_mobilisation": 0
      },
      "stability": -0.01
    },
    "ai_will_do": "ai_general_mobilisation"
  },

  "military_reform": {
    "name": "Military reform",
    "resource_costs": {"political_points": 35},
    "description": "New regulations, new staff colleges, and officers promoted for what they can do. An army that recovers and digs in faster.",
    "cooldown_days": 900,
    "gdp_cost_share": 0.003,
    "unavailable": "Requires peace and money to spend on it",
    "trigger": {
      "use": [
        "at_peace",
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
        "military_reform": 0
      },
      "army.experience": 0.05
    },
    "ai_will_do": "ai_military_reform"
  },

  "infrastructure_drive": {
    "name": "Infrastructure drive",
    "resource_costs": {"political_points": 20},
    "description": "Make roads, rail and grids the state's first priority for a year. Everything is built a fifth faster.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.004,
    "unavailable": "Requires money to spend on it",
    "trigger": {
      "use": [
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
        "infrastructure_drive": 0
      }
    },
    "ai_will_do": "ai_infrastructure_drive"
  },

  "reconstruction_programme": {
    "name": "Reconstruction programme",
    "resource_costs": {"political_points": 25},
    "description": "Rebuild what the war destroyed. For two years ruined regions are rebuilt twice as fast, and everything else is built a tenth faster.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.005,
    "unavailable": "Only a country with a region in ruins, and the money to rebuild it",
    "trigger": {
      "use": [
        "war_torn",
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
        "reconstruction_programme": 0
      }
    },
    "ai_will_do": "ai_reconstruction_programme"
  },

  "research_initiative": {
    "name": "National research initiative",
    "resource_costs": {"political_points": 20},
    "description": "Grants, laboratories and a minister for science. A fifth more research for a year.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.003,
    "unavailable": "Requires money to spend on it",
    "trigger": {
      "use": [
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
        "research_initiative": 0
      },
      "research": 15
    },
    "ai_will_do": "ai_research_initiative"
  },

  "tax_reform": {
    "name": "Tax reform",
    "resource_costs": {"political_points": 35},
    "description": "Simplify the code and close the loopholes. The state borrows on better terms, and every week somebody complains about it.",
    "cooldown_days": 1095,
    "gdp_cost_share": 0.001,
    "unavailable": "Only a settled country can take the argument",
    "trigger": {
      "use": [
        "settled"
      ]
    },
    "effects": {
      "add_modifier": {
        "tax_reform": 0
      }
    },
    "ai_will_do": "ai_tax_reform"
  },

  "naval_programme": {
    "name": "Naval programme",
    "resource_costs": {"political_points": 20, "naval_experience": 15},
    "description": "Give the yards the first call on steel. Hulls are laid down and finished a quarter faster.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.0035,
    "unavailable": "Requires money to spend on it",
    "trigger": {
      "use": [
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
        "naval_programme": 0
      },
      "fleet.readiness": 0.1
    },
    "ai_will_do": "ai_naval_programme"
  },

  "trade_offensive": {
    "name": "Trade offensive",
    "resource_costs": {"political_points": 15},
    "description": "Export credits and trade missions: every embassy becomes a sales office, and the country's goods travel further.",
    "cooldown_days": 540,
    "gdp_cost_share": 0.0015,
    "unavailable": "Trade offensives are for peacetime",
    "trigger": {
      "use": [
        "at_peace"
      ]
    },
    "effects": {
      "add_modifier": {
        "trade_offensive": 0
      }
    },
    "ai_will_do": "ai_trade_offensive"
  },

  "martial_law": {
    "name": "Declare martial law",
    "resource_costs": {"political_points": 25},
    "description": "Curfews, checkpoints and night courts for three months. The streets go quiet and so does the economy.",
    "cooldown_days": 720,
    "gdp_cost_share": 0.0005,
    "unavailable": "The country is calm enough not to need it",
    "trigger": {
      "use": [
        "restive"
      ]
    },
    "effects": {
      "add_modifier": {
        "martial_law": 0
      },
      "war_support": -0.01
    },
    "ai_will_do": "ai_martial_law"
  },

  "fortress_programme": {
    "name": "Fortress programme",
    "resource_costs": {"political_points": 15},
    "description": "Concrete and wire along every border that matters. Divisions dig in a quarter faster and hold better.",
    "cooldown_days": 730,
    "gdp_cost_share": 0.003,
    "unavailable": "Requires money to spend on it",
    "trigger": {
      "use": [
        "solvent"
      ]
    },
    "effects": {
      "add_modifier": {
