    "POL": "attrition",
    "BRA": "attrition",
    "EGY": "attrition",
    "VNM": "attrition",
    "NGA": "attrition",
    "PRK": "fortress",
    "IRN": "fortress",
    "FIN": "fortress",
    "TWN": "fortress",
    "CHE": "trading_state",
    "SGP": "trading_state",
    "NLD": "trading_state",
    "DEU": "trading_state",
    "CAN": "trading_state",
    "SWE": "trading_state",
    "NOR": "trading_state",
    "ISL": "trading_state",
    "IRL": "trading_state",
