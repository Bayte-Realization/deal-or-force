// Личные стратегические цели: то, чего игрок хочет от кампании, сказанное измеримыми шагами.
//
// Схема:
//   name / description  то, что читает игрок (английский текст — сам себе ключ);
//   milestones          шаги в порядке чтения; каждый — text + trigger тем же словарём,
//                       каким читается всякое условие в игре.
//
// Цель без единого измеримого шага — не цель, а пожелание, и каталогом отвергается.
{
  "the_peace_dividend": {
    "name": "The peace dividend",
    "description": "Bring the country to a place where the war is paid for by what it no longer spends, not by what it borrows: solvent, quiet and without troops in the field.",
    "milestones": [
      { "text": "At peace, with no formation committed to a war",
        "trigger": { "at_war": false } },
      { "text": "The treasury is solvent again",
        "trigger": { "use": ["solvent"] } },
      { "text": "The country is settled, not merely tired",
        "trigger": { "min_stability": 0.62 } }
    ]
  },

  "an_educated_generation": {
    "name": "An educated generation",
    "description": "Leave the country more schooled than it was found: literacy above four fifths, universities worth the name, and a standard of living that keeps the schooled at home.",
    "milestones": [
      { "text": "Four fifths of the country can read",
        "trigger": { "min_literacy": 0.8 } },
      { "text": "Nobody is leaving for want of a living",
        "trigger": { "min_standard_of_living": 0.55 } }
    ]
  },

  "an_honest_state": {
    "name": "An honest state",
    "description": "Leave no ruin standing, no classroom half empty and no province under the palm of a radical: heal the war's damage, school the country and hold it steady.",
    "milestones": [
      { "text": "No region of the country is still in ruins",
        "trigger": { "max_worst_war_damage": 0.05 } },
      { "text": "Three quarters of the country can read",
        "trigger": { "min_literacy": 0.75 } },
      { "text": "Radicalism has nowhere to stand",
        "trigger": { "min_stability": 0.7 } }
    ]
  },

  "a_market_of_ones_own": {
    "name": "A market of one's own",
    "description": "Make the domestic economy worth its own name: output past half a trillion, no dependence on a single supplier worth noticing, books that balance.",
    "milestones": [
      { "text": "The economy produces past half a trillion a year",
        "trigger": { "min_gdp": 500 } },
      { "text": "The treasury never has to borrow to exist",
        "trigger": { "min_treasury": 1 } }
    ]
  },

  "the_voice_of_the_region": {
    "name": "The voice of the region",
    "description": "Become the country the neighbours measure themselves against: no war lost, opinions warm, and the economy the largest on the continent.",
    "milestones": [
      { "text": "No neighbour holds an old grievance worth a war",
        "trigger": { "min_stability": 0.6 } },
      { "text": "The economy is the largest on the continent",
        "trigger": { "min_gdp": 1000 } }
    ]
  }
}
