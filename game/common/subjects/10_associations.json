// Two kinds of dependency the world of 2024 actually has and the first file has no word for.
// The grammar is the one in 00_subjects.json; `shares_overlord_politics` makes the subject
// governed the way its overlord is, every week.
{
  // Land one state rents from another and runs as a country of its own. The base world no longer
  // uses it: Baikonur and Guantanamo are leases of the land itself, the owner keeping it in law
  // (history/diplomacy 40_arrangements.json, LandArrangements.cs). Kept for a mod that wants a
  // rented territory to stand on the map as a country.
  "leased_territory": {
    "name": "Leased territory",
    "description": "Rented land, run and defended by the state that rents it. A country on the map, a district in practice.",
    "tribute": 0.0,
    "manpower": 0.0,
    "joins_wars": true,
    "dragged_into_wars": true,
    "may_declare_war": false,
    "overlord_defends": true,
    "liberty_desire": 0.0,
    "grace_days": 36500,
    "demand_cost": 20,
    "annex_after_days": -1,
    "imposable": false,
    "shares_overlord_politics": true,
    "receives_land_grants": false,
    // Nobody lives there to be raised against the tenant, and a lease ends when it ends.
    "agitable": false,
    "armed_rebellion": false
  },

  // A territory of another state with a government of its own: the British Overseas
  // Territories and Crown Dependencies, the French and Dutch overseas collectivities, Puerto
  // Rico and Guam, the Faroes and Greenland, Hong Kong and Macau. On the map a country; in
  // law and in war a part of the state it belongs to.
  "dependent_territory": {
    "name": "Dependent territory",
    "description": "A territory of another state, with a government of its own. Its defence and its foreign policy are the sovereign's.",
    "tribute": 0.0,
    "manpower": 0.0,
    "joins_wars": true,
    "dragged_into_wars": true,
    "may_declare_war": false,
    "overlord_defends": true,
    "liberty_desire": 0.02,
    "grace_days": 7300,
    "demand_cost": 25,
    "annex_after_days": -1,
    "imposable": false,
    "receives_land_grants": false,
    // One that wants out holds a referendum - New Caledonia has held three - not a war.
    "armed_rebellion": false
  },

  // A state in free association, or one living on a patron's money and garrison: the Compact
  // states with the United States, the Cook Islands and Niue with New Zealand, the breakaways
  // Russia and Turkey keep. Its own government, its own name, and somebody else's army.
  "associated_state": {
    "name": "Associated state",
    "description": "Its own government and its own name; its defence and much of its money come from its patron.",
    "tribute": 0.0,
    "manpower": 0.0,
    "joins_wars": true,
    "dragged_into_wars": false,
    "may_declare_war": false,
    "overlord_defends": true,
    "liberty_desire": 0.05,
    "grace_days": 3650,
    "demand_cost": 30,
    "annex_after_days": -1,
    "imposable": false,
    "receives_land_grants": false,
    // A free association is left by notice, and a patron's breakaway does not rise against
    // the army keeping it in being.
    "armed_rebellion": false
  }
}
