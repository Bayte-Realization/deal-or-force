// The world's resources: what the twenty-four goods of common/goods/30_world_resources.json are
// made of and what eats them. Shares of who makes what are in the deposits
// (history/states/2024/zz_world_resources.json); these recipes turn those points into market units.
//
// Generated by Tools/WorldResources/gen_recipes.py from one table of shapes and one of sizes
// (calib.json: "out" and "dem" per good), tuned so
// that at the 2024 start the world makes a little more of each than it asks for (SimBench
// --goods-probe). The goods that already existed are wired in where they are made: steel needs
// manganese, chromium, zinc and graphite (00_chains / 10_strategic_industry), fertiliser needs
// potash, textiles need cotton, the arsenal needs tungsten, titanium, gallium and advanced chips
// (20_military_industry), electronics need tin and gold.
//
// A `shortfall` recipe is zero while the input arrives and negative when it does not: that is
// how a grain shortage takes bread off the table, a chip shortage takes electronics off the
// shelves and a diesel shortage leaves harvests in the field.
{
  // Grain: the authored plains (deposit:Grain, share points) worked at the country's own staffing and
  // productivity - and at what war leaves of a region - plus every farm on ordinary land
  // (deposit:Food is the fertility every region has). Needs fertiliser and diesel. Eaten as
  // bread and rice and fed to animals: richer countries eat more of it through their meat.
  "grain_farming": {"good": "Grain", "output": {"deposit:Grain*output_factor": 20.12914, "deposit:Grain*Agriculture": 0.02626, "deposit:Food*Agriculture": 0.00088}, "demand": {"population": 0.0985, "population*urbanization*income": 0.2955, "Agriculture": 0.22162}, "needs": {"Fertiliser": 0.75, "Fuel": 0.85}},

  // What a country short of grain does not eat. Zero while grain arrives; a shortage takes bread
  // off the table in proportion - Cairo's subsidised loaf is made of Ukrainian and Russian wheat.
  "food_from_grain": {"good": "Food", "output": {"population": 0.4}, "shortfall": {"Grain": 0.0}},

  // Oilseeds and vegetable oil: palm in Indonesia and Malaysia, soy in the Americas, sunflower on the
  // Black Sea steppe. Cooking oil, feed and biodiesel.
  "oilseed_farming": {"good": "Oilseeds", "output": {"deposit:Oilseeds*output_factor": 4.61546, "deposit:Oilseeds*Agriculture": 0.09231, "deposit:Food*Agriculture": 0.00283}, "demand": {"population*income": 0.043, "population*standard_of_living*income": 0.0215, "ChemicalPlant": 0.0172, "Agriculture": 0.0129}, "needs": {"Fertiliser": 0.85}},

  // Cooking oil missed at the table.
  "food_from_oilseeds": {"good": "Food", "output": {"population": 0.06}, "shortfall": {"Oilseeds": 0.0}},

  // Cane and beet: Brazil, India and Thailand make half the world's sugar.
  "sugar_farming": {"good": "Sugar", "output": {"deposit:Sugar*output_factor": 2.49894, "deposit:Sugar*Agriculture": 0.04998, "deposit:Food*Agriculture": 0.00161}, "demand": {"population*income": 0.031, "population*standard_of_living*income": 0.0124, "ChemicalPlant": 0.0062}, "needs": {"Fertiliser": 0.85}},

  // Sugar missed at the table.
  "food_from_sugar": {"good": "Food", "output": {"population": 0.03}, "shortfall": {"Sugar": 0.0}},

  // Coffee, cocoa and tea: grown in the tropics, drunk where people can afford them.
  "cash_crop_plantations": {"good": "CashCrops", "output": {"deposit:CashCrops*output_factor": 0.6048, "deposit:CashCrops*Agriculture": 0.0121}, "demand": {"population*standard_of_living*income": 0.0104, "population*urbanization*income": 0.00312}},

  // The catch and the fish farms. A port lands more of it.
  "fishing": {"good": "Fish", "output": {"deposit:Fish*output_factor": 3.472, "deposit:Fish*raw:Port": 0.3472}, "demand": {"population": 0.026, "population*standard_of_living*income": 0.0208, "Agriculture": 0.0052}},

  // Fish missed at the table.
  "food_from_fish": {"good": "Food", "output": {"population": 0.05}, "shortfall": {"Fish": 0.0}},

  // Cotton, for the mills in textile_manufacture (which needs it).
  "cotton_farming": {"good": "Cotton", "output": {"deposit:Cotton*output_factor": 2.21502, "deposit:Cotton*Agriculture": 0.0443}, "demand": {"CivilianIndustry": 0.183, "population": 0.02471}},

  // Gold: jewellery for the rich and contacts for every circuit board (electronics need it).
  "gold_mining": {"good": "Gold", "output": {"deposit:Gold*extraction_efficiency": 0.29232}, "demand": {"population*standard_of_living*income": 0.00284, "ElectronicsPlant": 0.00142, "CivilianIndustry": 0.00057}},

  // Diamonds: gems, and the industrial grit machinery cannot be made without.
  "diamonds_mining": {"good": "Diamonds", "output": {"deposit:Diamonds*extraction_efficiency": 0.13888}, "demand": {"population*standard_of_living*income": 0.00107, "raw:ExtractionIndustry": 0.00032, "CivilianIndustry": 0.00021}},

  // Zinc and lead: galvanised steel, lead-acid batteries, bullets.
  "zinclead_mining": {"good": "ZincLead", "output": {"deposit:ZincLead*extraction_efficiency": 0.5376}, "demand": {"CivilianIndustry": 0.0261, "Smelter": 0.0261, "ArmsIndustry": 0.01566, "raw:Infrastructure": 0.00392}},

  // Tin: solder, for electronics and chips.
  "tin_mining": {"good": "Tin", "output": {"deposit:Tin*extraction_efficiency": 0.15568}, "demand": {"ElectronicsPlant": 0.0308, "CivilianIndustry": 0.0154}},

  // Tungsten: cutting tools, armour-piercing shot and turbines.
  "tungsten_mining": {"good": "Tungsten", "output": {"deposit:Tungsten*extraction_efficiency": 0.09744}, "demand": {"ArmsIndustry": 0.0253, "CivilianIndustry": 0.01012, "raw:ExtractionIndustry": 0.00506}},

  // Gallium and germanium: power and radar chips, night sights, fibre optics.
  "gallium_mining": {"good": "Gallium", "output": {"deposit:Gallium*extraction_efficiency": 0.04704}, "demand": {"ElectronicsPlant": 0.0316, "ArmsIndustry": 0.01896, "CivilianIndustry": 0.00474, "deposit:Semiconductors*output_factor": 0.00126, "deposit:AdvancedChips*output_factor": 0.00126}},

  // Manganese: every tonne of steel takes some, and battery cathodes more.
  "manganese_mining": {"good": "Manganese", "output": {"deposit:Manganese*extraction_efficiency": 0.58688}, "demand": {"Smelter": 0.1, "CivilianIndustry": 0.05, "ElectronicsPlant": 0.015}},

  // Chromium: stainless steel and the superalloys of jet engines.
  "chromium_mining": {"good": "Chromium", "output": {"deposit:Chromium*extraction_efficiency": 0.3416}, "demand": {"Smelter": 0.082, "CivilianIndustry": 0.0328, "ArmsIndustry": 0.0328}},

  // Platinum and palladium: exhaust catalysts, refinery catalysts, electronics.
  "platinummetals_mining": {"good": "PlatinumMetals", "output": {"deposit:PlatinumMetals*extraction_efficiency": 0.10528}, "demand": {"CivilianIndustry": 0.00281, "population*urbanization*income": 0.00084, "ChemicalPlant": 0.00112, "Refinery": 0.00112, "ElectronicsPlant": 0.00056}},

  // Potash: the potassium in fertiliser (fertiliser_production needs it).
  "potash_mining": {"good": "Potash", "output": {"deposit:Potash*extraction_efficiency": 0.7616}, "demand": {"Agriculture": 0.0156, "ChemicalPlant": 0.0078}},

  // Graphite: battery anodes and the electrodes of electric steel furnaces.
  "graphite_mining": {"good": "Graphite", "output": {"deposit:Graphite*extraction_efficiency": 0.196}, "demand": {"ElectronicsPlant": 0.113, "Smelter": 0.0565, "CivilianIndustry": 0.0226}},

  // Helium and neon: lithography lasers, chip fabs, MRI and research cryogenics.
  "noblegases_mining": {"good": "NobleGases", "output": {"deposit:NobleGases*extraction_efficiency": 0.07905}, "demand": {"ElectronicsPlant": 0.0396, "ResearchLab": 0.0594, "raw:Hospital": 0.0198, "CivilianIndustry": 0.00495, "deposit:Semiconductors*output_factor": 0.00594, "deposit:AdvancedChips*output_factor": 0.00594}},

  // Titanium sponge: airframes, engines, submarine hulls.
  "titanium_mining": {"good": "Titanium", "output": {"deposit:Titanium*extraction_efficiency": 0.07616}, "demand": {"ArmsIndustry": 0.0277, "CivilianIndustry": 0.00831, "Shipyard": 0.01385}},

  // Refined fuel. A country in 2024 already refines most of what it burns, so the base terms carry
  // it and a refinery adds capacity. Needs crude - which is why an oil embargo empties petrol
  // stations rather than just raising a price - and power.
  "fuel_refining": {"good": "Fuel", "output": {"Refinery": 1.3589, "population*urbanization": 0.33972, "CivilianIndustry": 0.20383, "deposit:Oil*extraction_efficiency": 0.10192}, "demand": {"population*urbanization*income": 0.138, "population*income": 0.0345, "Agriculture": 0.0483, "raw:Infrastructure": 0.0138, "Barracks": 0.0414}, "needs": {"Oil": 0.35, "Energy": 0.8, "PlatinumMetals": 0.95}},

  // Brazil's ethanol: cane that goes into the tank instead of the cup.
  "fuel_from_sugarcane": {"good": "Fuel", "output": {"deposit:Sugar*output_factor": 0.012}, "needs": {"Sugar": 0.5}},

  // Diesel and jet fuel for the forces, on top of the crude bill in army_fuel_upkeep.
  "army_refined_fuel_upkeep": {"good": "Fuel", "scope": "nation", "demand": {"divisions": 0.0069, "divisions_at_war": 0.0138, "hulls": 0.00276}},

  // A farm without diesel: tractors stand and harvests rot. Zero while fuel arrives.
  "food_from_fuel": {"good": "Food", "output": {"Agriculture": 0.6}, "shortfall": {"Fuel": 0.0}},

  // Polymers from oil and gas chemistry.
  "plastics_production": {"good": "Plastics", "output": {"ChemicalPlant": 1.16928, "Refinery": 0.4872, "CivilianIndustry": 0.43848, "deposit:NaturalGas*extraction_efficiency": 0.04872, "deposit:Oil*extraction_efficiency": 0.03898}, "demand": {"CivilianIndustry": 0.087, "population*urbanization*income": 0.0522, "ElectronicsPlant": 0.0435, "raw:Infrastructure": 0.0087}, "needs": {"Chemicals": 0.6, "Energy": 0.7}},

  // Everything households buy comes wrapped in, or made of, plastic.
  "consumer_goods_from_plastics": {"good": "ConsumerGoods", "output": {"CivilianIndustry": 0.5}, "shortfall": {"Plastics": 0.0}},

  // The foundries: Hsinchu, Tainan, Pyeongtaek, Shanghai, Malta NY, Dresden (deposit:Semiconductors
  // is fab capacity, history/states/2024/zz_world_resources.json). They run on Dutch and Japanese
  // tools, neon and gallium, so a tool embargo reaches every one of them.
  "foundry_semiconductors": {"good": "Semiconductors", "output": {"deposit:Semiconductors*output_factor": 1.53, "deposit:Semiconductors*ElectronicsPlant": 0.153}, "needs": {"ChipTools": 0.8, "NobleGases": 0.75, "Gallium": 0.85, "Silica": 0.7, "Chemicals": 0.7, "Energy": 0.55}},

  // Leading-edge logic. Nine in ten were made in Taiwan in 2024; nothing else on this list is
  // as concentrated, and nothing a modern economy or army runs on is harder to replace.
  "advanced_chip_fabs": {"good": "AdvancedChips", "output": {"deposit:AdvancedChips*output_factor": 0.21757, "deposit:AdvancedChips*ElectronicsPlant": 0.02176}, "demand": {"ElectronicsPlant": 0.043, "CivilianIndustry": 0.01075, "ResearchLab": 0.0215, "ArmsIndustry": 0.0172, "population*urbanization*income": 0.00172}, "needs": {"ChipTools": 0.7, "NobleGases": 0.65, "Gallium": 0.9, "Silica": 0.85, "Chemicals": 0.8, "Energy": 0.6}},

  // Phones, servers and cars without leading-edge chips: the shortfall a Taiwan war sends round the world.
  // Floored at 0.4: older nodes stand in for part of what is missing, and most importers already
  // live below full supply in 2024 (export controls, the import ceiling in TradeNetwork).
  "electronics_advanced_chip_dependency": {"good": "Electronics", "output": {"CivilianIndustry": 0.6, "ElectronicsPlant": 0.6}, "shortfall": {"AdvancedChips": 0.4}},

  // Lithography, etch and deposition tools (deposit:ChipTools: ASML, Zeiss, Applied, Lam, KLA, Tokyo
  // Electron). Wanted wherever fabs stand, and in proportion to them.
  "chipmaking_equipment": {"good": "ChipTools", "output": {"deposit:ChipTools*output_factor": 0.0672, "deposit:ChipTools*ResearchLab": 0.01344}, "demand": {"deposit:Semiconductors*output_factor": 0.031, "deposit:AdvancedChips*output_factor": 0.031, "ElectronicsPlant": 0.0186, "ResearchLab": 0.0031}, "needs": {"PrecisionComponents": 0.7, "Machinery": 0.8, "Electronics": 0.8}},

  // Enrichment halls (deposit:NuclearFuel): Rosatom, Urenco, Orano, CNNC.
  "uranium_enrichment": {"good": "NuclearFuel", "output": {"deposit:NuclearFuel*output_factor": 0.384}, "demand": {"PowerPlant": 0.131, "population*urbanization*income": 0.00655}, "needs": {"Uranium": 0.5, "Energy": 0.7}},

  // Reactors without fuel. Small - most of the world's power is not nuclear - and zero while it comes.
  "energy_nuclear_fuel_dependency": {"good": "Energy", "output": {"PowerPlant": 0.3, "population*urbanization": 0.03}, "shortfall": {"NuclearFuel": 0.0}}
}
