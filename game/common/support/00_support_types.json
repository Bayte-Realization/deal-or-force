// Long-range formations - what a country reaches with rather than what it stands on.
//
// An entry is a KIND of formation: what the world opens with, what a player can raise,
// and what a mod can add by dropping another file into common/support. Nothing here is
// compiled in; a field left out of a new kind is a zero, and a new kind of formation needs no
// code. A later file naming a kind that already exists changes only the fields it names:
// { "mlrs_battalion": { "range_km": 120 } } is longer-legged rocket artillery and nothing else.
// mods/_templates/long_range_forces does both.
//
//   kind             what the formation IS: ground guns, crewed aircraft, drones, or
//                    missile brigades that never leave home. The kind decides which
//                    rules apply - a missile brigade covers its own ground whatever it
//                    was told, everything else works the mission it was given.
//   range_km         how far from its base the formation projects, in real kilometres.
//   support_fire     what it adds to friendly attacks in battles inside the radius,
//                    saturating: the first brigade is a real help, the eleventh a rumour.
//   air_superiority  what it takes off the ENEMY's long-range fire over the same ground -
//                    fighters on the sweep, suppressing guns and attack aircraft alike.
//   interdiction     what it strips from enemy defence in battles inside the radius:
//                    the barrage that finds the depots and the roads behind the front.
//   air_defence      the ground's own answer to aircraft: a missile brigade's reach is
//                    measured from home, and enemy fire over it pays the price.
//   recon            what the formation can see. Priced in, shown to the player, and the
//                    reason a cheap drone group is worth more than its fire suggests.
//   recruitment_cost fraction of the money a division of infantry costs - the same
//                    budget a country buys its armies with.
//   build_days       from the order to the formation existing.
//   personnel        people taken out of the manpower reserve - fewer than a division,
//                    because a wing is not a regiment of riflemen.
//   missions         what the formation may be ordered to do. "standby" is always
//                    available; the rest say what the formation does with its days.
//                    "reconnaissance" lifts the fog over enemy ground inside the reach,
//                    as far as the recon figure says (six sees all of it), and pays the
//                    enemy's sky for it (AirReconnaissance.cs). "strike" fires one salvo a
//                    week at a target behind the line - the enemy's formations, depots,
//                    plants or power grid (LongRangeStrikes.cs).
//   strike           deep-strike power of one weekly salvo at full strength. The enemy's
//                    air defence in reach of the target shoots part of it down; what gets
//                    through lands as hard as the reconnaissance over the target allows.
//   munition         the depot good a salvo is fired from: Missiles, Drones or Ammunition.
//                    An empty depot fires nothing - the strike war is a war of factories.
//   munition_per_salvo  how much of it one full-strength salvo takes.
//   evasion          0 to 1: the share of the enemy's interception the weapon shrugs off.
//                    Ballistic missiles high, cruise missiles middling, slow drones low -
//                    which is why drones come in swarms that saturate a screen.
//
// The stock game's eleven kinds are balanced against a division's fire of about one, so
// that a country's whole long-range establishment over one battle is worth roughly a
// third again of the divisions actually standing in it - decisive when it is aimed,
// never a replacement for holding the ground.
{
  "artillery_brigade": {
    "name": "Artillery brigade",
    "kind": "ground",
    "icon": "artillery",
    "range_km": 45,
    "support_fire": 6.0,
    "interdiction": 1.5,
    "recon": 0.5,
    "recruitment_cost": 0.50,
    "build_days": 45,
    "personnel": 4500,
    "missions": ["standby", "close_air_support", "interdiction"]
  },

  // The rocket half of the gun line: half again the reach of a howitzer and the
  // interdiction to match - a battery that finds a road column empties it.
  "mlrs_battalion": {
    "name": "Rocket artillery battalion",
    "kind": "ground",
    "icon": "artillery",
    "range_km": 90,
    "support_fire": 5.0,
    "interdiction": 3.5,
    "recon": 0.8,
    "strike": 3.0,
    "munition": "Ammunition",
    "munition_per_salvo": 0.4,
    "evasion": 0.35,
    "recruitment_cost": 0.70,
    "build_days": 50,
    "personnel": 3500,
    "missions": ["standby", "close_air_support", "interdiction", "strike"]
  },

  // The ground's own answer to the air war. No offensive mission at all: a missile
  // brigade covers its home region's radius whatever it was told, which is the point
  // of it - the enemy's aircraft pay before the battle is even joined.
  "sam_brigade": {
    "name": "Missile brigade",
    "kind": "air_defence",
    "icon": "sam",
    "range_km": 130,
    "air_defence": 10.0,
    "recon": 1.0,
    "recruitment_cost": 0.80,
    "build_days": 60,
    "personnel": 3000,
    "missions": ["standby"]
  },

  // The sweep: the longest legs in the book and the only formation whose air
  // superiority is worth the name. Without bombs worth mentioning, but the sky it
  // clears is what every other aircraft's work depends on.
  "fighter_wing": {
    "name": "Fighter wing",
    "kind": "air",
    "icon": "air",
    "range_km": 550,
    "support_fire": 3.5,
    "air_superiority": 12.0,
    "interdiction": 2.0,
    "recon": 1.5,
    "recruitment_cost": 1.60,
    "build_days": 90,
    "personnel": 2400,
    "missions": ["standby", "air_superiority", "close_air_support", "interdiction", "reconnaissance"]
  },

  // The ground attack wing: what a close support mission is for. Half a fighter's
  // sweep, four times its fire - and it needs the sweep of something else overhead.
  "attack_aircraft_wing": {
    "name": "Attack aircraft wing",
    "kind": "air",
    "icon": "air",
    "range_km": 420,
    "support_fire": 9.0,
    "air_superiority": 3.0,
    "interdiction": 3.0,
    "recon": 2.0,
    "strike": 4.0,
    "munition": "Ammunition",
    "munition_per_salvo": 0.5,
    "evasion": 0.3,
    "recruitment_cost": 1.40,
    "build_days": 80,
    "personnel": 2800,
    "missions": ["standby", "close_air_support", "interdiction", "strike", "reconnaissance"]
  },

  // The low, slow half of the air war: the shortest reach of any aircraft and the
  // heaviest fire per kilometre of it. What a country with a small budget flies instead.
  "attack_helicopter_regiment": {
    "name": "Attack helicopter regiment",
    "kind": "air",
    "icon": "air",
    "range_km": 180,
    "support_fire": 8.0,
    "air_superiority": 1.5,
    "interdiction": 1.5,
    "recon": 2.5,
    "recruitment_cost": 1.00,
    "build_days": 70,
    "personnel": 3200,
    "missions": ["standby", "close_air_support", "reconnaissance"]
  },

  // The deep end: the reach to work the whole theatre and the interdiction to shut a
  // province's roads for a week. Almost no air presence of its own to speak of.
  "strategic_bomber_regiment": {
    "name": "Strategic bomber regiment",
    "kind": "air",
    "icon": "air",
    "range_km": 1600,
    "support_fire": 6.0,
    "interdiction": 6.0,
    "recon": 2.0,
    "strike": 10.0,
    "munition": "Missiles",
    "munition_per_salvo": 0.8,
    "evasion": 0.3,
    "recruitment_cost": 2.20,
    "build_days": 120,
    "personnel": 4000,
    "missions": ["standby", "close_air_support", "interdiction", "strike", "reconnaissance"]
  },

  // The eyes. Almost no fire at all, and no country that owns one regrets it: the
  // reach of a strategic aircraft at the price of a good battery.
  "recon_drone_group": {
    "name": "Reconnaissance drone group",
    "kind": "drone",
    "icon": "drone",
    "range_km": 700,
    "support_fire": 0.5,
    "interdiction": 1.0,
    "recon": 6.0,
    "recruitment_cost": 0.35,
    "build_days": 30,
    "personnel": 400,
    "missions": ["standby", "interdiction", "close_air_support", "reconnaissance"]
  },

  // The modern cheap shot: a quarter of a fighter's cost, most of an attack wing's
  // work, and nobody aboard to lose. Fragile over a front that is defended - which is
  // what the suppression of a missile brigade or a fighter sweep means in practice.
  "strike_drone_group": {
    "name": "Strike drone group",
    "kind": "drone",
    "icon": "drone",
    "range_km": 400,
    "support_fire": 4.5,
    "interdiction": 2.5,
    "recon": 2.0,
    "strike": 2.5,
    "munition": "Drones",
    "munition_per_salvo": 0.3,
    "evasion": 0.15,
    "recruitment_cost": 0.50,
    "build_days": 40,
    "personnel": 600,
    "missions": ["standby", "close_air_support", "interdiction", "strike", "reconnaissance"]
  },

  // The deep end of the ground war: cruise and ballistic missiles on launchers that never
  // see the front. Nothing to add to a battle, everything to take from the depots, plants
  // and power stations a thousand kilometres behind it - and a salvo is a week of what the
  // missile plants make, so a country that fires faster than it builds runs dry.
  "strike_missile_brigade": {
    "name": "Strike missile brigade",
    "kind": "ground",
    "icon": "artillery",
    "range_km": 900,
    "interdiction": 2.0,
    "recon": 0.5,
    "strike": 9.0,
    "munition": "Missiles",
    "munition_per_salvo": 0.6,
    "evasion": 0.55,
    "recruitment_cost": 1.20,
    "build_days": 75,
    "personnel": 1500,
    "missions": ["standby", "strike"]
  },

  // The cheapest reach in the book: slow one-way drones launched in swarms from far behind
  // the line. Each is easy to shoot down and there are a great many of them - the screen
  // that stops a few is saturated by a hundred - and nothing aboard to lose.
  "long_range_drone_group": {
    "name": "Long-range attack drone group",
    "kind": "drone",
    "icon": "drone",
    "range_km": 1500,
    "recon": 1.0,
    "strike": 4.0,
    "munition": "Drones",
    "munition_per_salvo": 0.5,
    "evasion": 0.1,
    "recruitment_cost": 0.40,
    "build_days": 30,
    "personnel": 500,
    "missions": ["standby", "strike"]
  }
}
