  // The modern cheap shot: a quarter of a fighter's cost, most of an attack wing's
  // work, and nobody aboard to lose. Fragile over a front that is defended - which is
  // what the suppression of a missile brigade or a fighter sweep means in practice.
  "strike_drone_group": {
    "name": "Strike drone group",
    "kind": "drone",
    "icon": "drone",
    "range_km": 400,
    "support_fire": 4.5,
    "interdiction": 2.5,
    "recon": 2.0,
    "recruitment_cost": 0.50,
    "build_days": 40,
    "personnel": 600,
    "missions": ["standby", "close_air_support", "interdiction"]
  }
}
