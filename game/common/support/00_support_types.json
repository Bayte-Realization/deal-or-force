  "strategic_bomber_regiment": {
    "name": "Strategic bomber regiment",
    "kind": "air",
    "icon": "air",
    "range_km": 1600,
    "support_fire": 6.0,
    "interdiction": 6.0,
    "recon": 2.0,
    "recruitment_cost": 2.20,
    "build_days": 120,
    "personnel": 4000,
    "missions": ["standby", "close_air_support", "interdiction"]
  },

  // The eyes. Almost no fire at all, and no country that owns one regrets it: the
  // reach of a strategic aircraft at the price of a good battery.
  "recon_drone_group": {
    "name": "Reconnaissance drone group",
    "kind": "drone",
    "icon": "drone",
    "range_km": 700,
    "support_fire": 0.5,
    "interdiction": 1.0,
    "recon": 6.0,
    "recruitment_cost": 0.35,
    "build_days": 30,
    "personnel": 400,
    "missions": ["standby", "interdiction", "close_air_support"]
