// The options screen, as data.
//
// The screen is built out of this file - the categories, the order, the words, the ranges
// and the defaults. The code's only job is to know what to *do* about an id it recognises,
// so a mod can reorder the screen, rename anything, widen a range, change a default, or add
// an option of its own and read it back in its own script.
//
//   category      which tab it sits under
//   kind          "toggle", "choice" or "slider"
//   default       true/false for a toggle, a number for a slider, a string for a choice
//   values        a choice's values; `labels` are the words shown for them
//   minimum/maximum/step   a slider's range
//   unit          how a slider's number is written: percent, number, days, pixels
//   needs_restart whether it takes effect now or at the next start
//
// To hide an option rather than fork this file, give it a category the screen does not show.
{
  // ---------------------------------------------------------------- the game itself -----
  "save_format": {
    "category": "game", "scope": "campaign", "order": 95, "kind": "choice",
    "name": "Save format",
    "description": "Compressed saves are a tenth of the size and quicker to write, which a century of history written every month will notice. Text saves open in any editor: change a number, load the campaign again, carry on - and there is no checksum to argue with.",
    "values": ["false", "true"],
    "labels": ["Compressed", "Text (editable)"],
    "default": "false"
  },
  "autosave_interval": {
    "category": "game", "scope": "campaign", "order": 100, "kind": "choice",
    "name": "Autosave",
    "description": "How often the campaign saves itself. Autosaves are kept apart from your own and never overwrite them.",
    "values": ["0", "7", "30", "90", "365"],
    "labels": ["Never", "Weekly", "Monthly", "Quarterly", "Yearly"],
    "default": "30"
  },
  "event_interval": {
    "category": "game", "scope": "campaign", "order": 101, "kind": "choice",
    "name": "Events",
    "description": "How often your country is asked to decide something that happened to it. Rarely is a decision or two a year; often is the old cadence, about one a season.",
    "values": ["0", "250", "125", "75"],
    "labels": ["Never", "Rarely", "Normally", "Often"],
    "default": "125"
  },
  // Two dials on the computer's governments, per campaign (AiTemper). 100% is the game as tuned.
  "ai_aggression": {
    "category": "game", "scope": "campaign", "order": 102, "kind": "slider",
    "name": "Aggressiveness of other governments",
    "description": "How readily the governments you do not play go to war. Lower makes cautious cabinets that need a strong reason; higher makes adventurers who take their chances. Every reason behind a war still counts - only the appetite moves.",
    "minimum": 0.25, "maximum": 2.0, "step": 0.05, "default": 1.0, "unit": "percent"
  },
  "ai_agreeableness": {
    "category": "game", "scope": "campaign", "order": 103, "kind": "slider",
    "name": "Agreeableness of other governments",
    "description": "How readily the governments you do not play say yes - to treaties, peace offers, aid and pleas to join a war. Lower makes them stubborn bargainers; higher makes them easy to persuade.",
    "minimum": 0.25, "maximum": 2.0, "step": 0.05, "default": 1.0, "unit": "percent"
  },
  "civil_wars_players": {
    "category": "game", "scope": "campaign", "order": 104, "kind": "toggle",
    "name": "Civil-war outbreaks in player countries",
    "description": "Permit the same weekly instability-driven civil-war outbreaks in your country as in other states. The Laws and agendas crisis workspace shows the exact current risk and recovery protection. This is not a guaranteed countdown.",
    "default": true
  },
  "peace_by_provinces": {
    "category": "game", "scope": "campaign", "order": 105, "kind": "toggle",
    "name": "Peace by provinces",
    "description": "Off: a peace treaty hands over whole regions only, so borders follow the map's regions. On: every treaty, other governments' as well as yours, takes exactly the provinces it names, and the border runs where the armies stopped. Regions cut in two stay cut.",
    "default": false
  },
  "show_first_steps": {
    "category": "interface", "order": 205, "kind": "toggle",
    "name": "First steps",
    "description": "The short list of things to try first on the situation rail: let time run, read the budget, choose research, build, look at the neighbours, order a division, open the handbook. Each is ticked once done.",
    "default": true
  },
  "pause_on_event": {
    "category": "game", "order": 110, "kind": "toggle",
    "name": "Pause when something happens",
    "description": "Stop time when an event arrives. Off is the honest setting in multiplayer, where one player's event should not stop everybody else's war.",
    "default": true
  },
  "confirm_declaration": {
    "category": "game", "order": 120, "kind": "toggle",
    "name": "Confirm before declaring war",
    "description": "Ask twice before starting a war. There is no undo and there is no peace button on the other side of it.",
    "default": true
  },
  "hours_per_tick": {
    "category": "game", "scope": "campaign", "order": 130, "kind": "choice",
    "name": "Length of a simulation step",
    "description": "How much campaign time one step covers. Six hours moves armies in smaller pieces more often; seventy-two runs three days at once, which is a real fast-forward for a quiet decade. The answer does not change with it.",
    "values": ["1", "3", "6", "12", "24", "48", "72"],
    "labels": ["One hour", "Three hours", "6 hours", "12 hours", "A day", "Two days", "Three days"],
    "default": "1"
  },

  // ---------------------------------------------------------------- the interface --------
  "language": {
    "category": "interface", "order": 200, "kind": "choice",
    "name": "Language",
    "description": "Mods add their own by dropping localization/<language>/ into the mod folder.",
    "values": [], "labels": [],
    "default": "english"
  },
  "tooltip_width": {
    "category": "interface", "order": 210, "kind": "slider",
    "name": "Tooltip width",
    "description": "How wide a tooltip is allowed to get before it wraps, counted in characters. Narrower reads more easily; wider fits more on a line.",
    "minimum": 48, "maximum": 140, "step": 4, "default": 84, "unit": "number"
  },
  "dim_behind_events": {
    "category": "interface", "order": 220, "kind": "toggle",
    "name": "Darken the screen behind an event",
    "description": "Off leaves the map readable while an event is open, and lets you drag the window out of the way and keep playing.",
    "default": false
  },
  "region_names": {
    "category": "interface", "order": 230, "kind": "toggle",
    "name": "Country names on the map",
    "description": "Draw each country's name across its territory.",
    "default": true
  },
  "map_divisions": {
    "category": "interface", "order": 232, "kind": "choice",
    "name": "Divisions on the map",
    "description": "Which armies the map draws. Ours, allies and wars: your own, your allies' and dependencies', and every country that is fighting - a quiet country's barracks are not news, and two hundred countries' peacetime garrisons buried Europe in counters. All: every division in the world. Ours only: your own.",
    "values": ["relevant", "all", "ours"],
    "labels": ["Ours, allies and wars", "All", "Ours only"],
    "default": "relevant"
  },
  "headline_popups": {
    "category": "interface", "order": 233, "kind": "choice",
    "name": "Headlines as they happen",
    "description": "News that comes up on the screen the moment it happens, with why it concerns you: everything about your own country, what happens to your allies, neighbours and enemies, and the world's news only when a great power is in it. A few cards at a time, never a dialog - the full feed is always in the reports.",
    "values": ["important", "mine", "all", "off"],
    "labels": ["Important to me", "My country only", "Everything notable", "Off"],
    "default": "important"
  },
  "city_names": {
    "category": "interface", "order": 235, "kind": "toggle",
    "name": "Cities on the map",
    "description": "Mark the cities with a dot and their name: the capitals and the great cities from far out, the towns as you come closer. Names never overlap.",
    "default": true
  },
  "map_smoothing": {
    "category": "interface", "order": 240, "kind": "toggle",
    "name": "Smooth the map",
    "description": "Rebuild country, region and terrain boundaries so the map has no visible texel grid. Off is the raster exactly as authored - pixels and all - and the cheaper picture on a slower machine.",
    "default": true
  },
  "space_backdrop": {
    "category": "interface", "order": 245, "kind": "toggle",
    "name": "Stars behind the globe",
    "description": "The photographed sky the world hangs in. Off leaves the flat colour behind it, which is quieter to look at and one less texture to hold.",
    "default": true
  },
  "map_clouds": {
    "category": "interface", "order": 246, "kind": "toggle",
    "name": "Clouds",
    "description": "Clouds drifting over the world from far away, parting as the camera comes down. Off leaves the borders clear at every distance. Also a button on the map bar and on the country-select screen.",
    "default": true
  },
  "map_mist": {
    "category": "interface", "order": 247, "kind": "toggle",
    "name": "Fog-of-war mist",
    "description": "Close up, a drifting veil over the ground your country cannot see. Only its look: what is hidden stays hidden either way. Also a button on the map bar.",
    "default": true
  },
  "map_trade_traffic": {
    "category": "interface", "order": 248, "kind": "toggle",
    "name": "Trade on the map",
    "description": "Ships on the sea lanes between the world's busiest trading partners, and lorries on the roads between neighbours - more for the larger trade. They stop when the clock does.",
    "default": true
  },
  "map_event_pulses": {
    "category": "interface", "order": 249, "kind": "toggle",
    "name": "Events on the map",
    "description": "A ring where something has just happened: a war, a split, a coup, a new country. It fades. Off leaves the map quiet.",
    "default": true
  },
  "map_ambience": {
    "category": "audio", "order": 425, "kind": "toggle",
    "name": "Sound of the map",
    "description": "High wind from the strategic height, open country close to the ground, and the guns of a front the camera is near. At the effects volume.",
    "default": true
  },

  "projection": {
    "category": "interface", "order": 250, "kind": "choice",
    "name": "Map view",
    "description": "The globe, or the classic flat map that wraps around for ever.",
    "values": ["globe", "flat"],
    "labels": ["3D globe", "Flat map"],
    "default": "globe"
  },

  // A country whose name is an argument can offer the argument as an option. The value is a
  // suffix on the localisation key - `country.BLR.name.belarus` - so a mod adds the same for
  // Ireland, Macedonia or the Persian Gulf with one entry here and two rows of localisation,
  // and no code at all. A variant with no row behind it changes nothing, which is a perfectly
  // good thing for an option to do.
  "country_name_blr": {
    "category": "interface", "order": 260, "kind": "choice",
    "name": "What Belorussia is called",
    "description": "If you are that BelOrussian (or however you would have it) who takes offence at plain fact, and you want your favourite country's favourite name transliterated your way THAT badly, then fear not: I have seen to your feelings!",
    "values": ["belorussia", "belarus"],
    "labels": ["country.BLR.name.belorussia", "country.BLR.name.belarus"],
    "default": "belorussia"
  },
  "country_name_mda": {
    "category": "interface", "order": 261, "kind": "choice",
    "name": "What Moldova is called",
    "description": "If the name of (a) (your) random semi-European third-world country matters to you that much, then fear not - I don't care))))",
    "values": ["whatever"],
    "labels": ["Whatever"],
    "default": "whatever"
  },

  // A movement flies a banner in its colours unless this is on, and then the flag it really
  // flies - `gfx/flags/flag_<tag>_insignia.png`, for any tag that has one, a mod's included.
  "movement_flags": {
    "category": "interface", "order": 262, "kind": "toggle",
    "name": "Movements fly their own flags",
    "description": "Show authored movement insignia when available. Disable to use their alternate plain banners.",
    "default": true
  },

  // ---------------------------------------------------------------- what it looks like ---
  "window_mode": {
    "category": "video", "order": 300, "kind": "choice",
    "name": "Window",
    "description": "Borderless gives you fullscreen that you can alt-tab out of instantly.",
    "values": ["fullscreen", "borderless", "windowed"],
    "labels": ["Fullscreen", "Borderless", "Windowed"],
    "default": "borderless"
  },
  "renderer": {
    "category": "video", "order": 305, "kind": "choice", "needs_restart": true,
    "name": "Graphics renderer",
    "description": "What draws the game. Automatic uses the best the machine has and, if the picture stays black, steps down by itself at the next start. OpenGL draws on nearly anything; OpenGL through Direct3D 11 (ANGLE) is for old or awkward graphics drivers.",
    "values": ["auto", "d3d12", "vulkan", "opengl3", "opengl3_angle"],
    "labels": ["Automatic", "Direct3D 12", "Vulkan", "OpenGL", "OpenGL (ANGLE)"],
    "default": "auto"
  },
  "window_size": {
    "category": "video", "order": 302, "kind": "choice",
    "name": "Window size",
    "description": "The size of the window in Windowed mode. Fullscreen and Borderless always use the monitor's own resolution.",
    "values": ["1280x720", "1600x900", "1920x1080", "2560x1440", "3440x1440", "3840x2160"],
    "labels": ["1280 × 720", "1600 × 900", "1920 × 1080", "2560 × 1440", "3440 × 1440", "3840 × 2160"],
    "default": "1920x1080"
  },
  "graphics_quality": {
    "category": "video", "order": 314, "kind": "choice",
    "name": "Graphics quality",
    "description": "How much of the picture the game may spend on this machine. Automatic starts from what the graphics card is and lowers the picture by itself when the frame rate falls; a named level stays where it is put.",
    "values": ["auto", "high", "balanced", "low", "software"],
    "labels": ["Automatic", "High", "Balanced", "Low", "Processor"],
    "default": "auto"
  },
  "render_scale": {
    "category": "video", "order": 315, "kind": "choice",
    "name": "Map render resolution",
    "description": "How many of the screen's pixels the map is drawn with. Native is the sharpest. Lower values are scaled up and help a weak graphics card.",
    "values": ["1.0", "0.85", "0.75", "0.5"],
    "labels": ["Native", "85%", "75%", "50%"],
    "default": "1.0"
  },
  "map_antialiasing": {
    "category": "video", "order": 316, "kind": "choice",
    "name": "Map edge smoothing",
    "description": "The planet's silhouette and the markers standing on it are the only hard geometric edges on the map, and smoothing them costs a little fill rate. Off shows the staircase and costs nothing; four samples is the smoothest. Takes effect when a campaign is loaded.",
    "values": ["4x", "2x", "off"],
    "labels": ["4 samples", "2 samples", "Off"],
    "default": "4x"
  },
  "smooth_ticks": {
    "category": "video", "order": 305, "kind": "toggle",
    "name": "Smooth time",
    "description": "Spreads each day's and each week's calculations over several frames, so the picture never stops for them. The world comes out exactly the same either way.",
    "default": true
  },
  "vsync": {
    "category": "video", "order": 310, "kind": "toggle",
    "name": "Wait for the monitor",
    "description": "On stops the picture tearing; off lets the frame rate go as high as the machine can and costs a little latency.",
    "default": true
  },
  "max_fps": {
    "category": "video", "order": 320, "kind": "choice",
    "name": "Frame rate limit",
    "description": "A cap below what the machine can manage is a quieter fan and a cooler room for a strategy game that does not need 300 frames a second.",
    "values": ["0", "30", "60", "120", "144", "240"],
    "labels": ["Unlimited", "30", "60", "120", "144", "240"],
    "default": "0"
  },
  "interface_scale": {
    "category": "video", "order": 330, "kind": "slider",
    "name": "Interface size",
    "description": "Everything the interface draws, larger or smaller. Worth raising on a 4K display and lowering on a small one.",
    "minimum": 0.75, "maximum": 1.75, "step": 0.05, "default": 1.0, "unit": "percent"
  },

  // ---------------------------------------------------------------- sound ----------------
  "volume_master": {
    "category": "audio", "order": 400, "kind": "slider",
    "name": "Everything",
    "description": "The volume every other one is measured against.",
    "minimum": 0, "maximum": 1, "step": 0.05, "default": 0.85, "unit": "percent"
  },
  "volume_music": {
    "category": "audio", "order": 410, "kind": "slider",
    "name": "Music",
    "minimum": 0, "maximum": 1, "step": 0.05, "default": 0.55, "unit": "percent"
  },
  "volume_effects": {
    "category": "audio", "order": 420, "kind": "slider",
    "name": "Effects",
    "minimum": 0, "maximum": 1, "step": 0.05, "default": 0.80, "unit": "percent"
  }
}
