// The pictures behind the loading dossier and the main menu were generated, and the game does
// not lead with them. Both switches are ON as shipped: the loading screen is the drawn chart -
// the grid, the frame, the seal and the dossier - and the menu is the drawn atlas, the
// graticule on a dark ground and the globe's limb. Turning a switch off brings the
// illustrations back for anybody who prefers them.
//
// The identifiers keep their first names because saved settings are stored under them; the
// captions are what changed. They used to call the game's own pictures "AI-slop" on its own
// options screen, with the pictures on by default - an insult and a default that contradicted
// each other.
{
  "loading_without_ai_art": {
    "category": "interface", "order": 206, "kind": "toggle", "default": true,
    "name": "Plain loading screens",
    "description": "On: the loading screen is the drawn chart - the grid, the frame, the seal and the dossier. Off: generated illustrations are shown behind the dossier."
  },
  "menu_without_ai_art": {
    "category": "interface", "order": 207, "kind": "toggle", "default": true,
    "name": "Plain main menu",
    "description": "On: the main menu is the drawn atlas - the graticule on a dark ground and the limb of the globe. Off: generated illustrations drift behind the menu. Takes effect at once."
  }
}
