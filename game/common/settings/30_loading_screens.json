// The pictures behind the loading dossier and the main menu were generated, and the game does
// not lead with them. Both switches are ON as shipped: the loading screen shows the game's own
// world behind the dossier, and the menu stands on the live planet baked from the game's own
// map (MenuGlobe). Turning a switch off brings the illustrations back for anybody who prefers
// them.
//
// The captions say "AI-slop" on purpose. It is the owner's own joke at the game's expense and
// he wants it kept: they were renamed to "Plain ..." once and he asked for the old names
// back. The identifiers never changed, so saved settings are untouched either way.
{
  "loading_without_ai_art": {
    "category": "interface", "order": 206, "kind": "toggle", "default": true,
    "name": "Turn off the AI-slop loading screens",
    "description": "The illustrations behind the loading dossier were generated by a neural network. On: the loading screen shows the game's own world behind the dossier, nothing generated. Off: the generated illustrations are shown behind it."
  },
  "menu_without_ai_art": {
    "category": "interface", "order": 207, "kind": "toggle", "default": true,
    "name": "Turn off the AI-slop main menu pictures",
    "description": "The illustrations behind the main menu were generated by a neural network. On: the menu stands on the live planet drawn from the game's own map, nothing generated. Off: the generated illustrations drift over it. Takes effect at once."
  }
}
