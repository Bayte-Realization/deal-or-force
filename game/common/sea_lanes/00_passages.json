// Deal or Force - the narrows.
//
// The sea lanes are one-degree squares, and at that size the Bosporus, the Suez Canal and
// half the straits of Europe are not there. Each entry here is a line of [latitude,
// longitude] points the lanes treat as water whatever the map says.
//
//   "closes_to_enemies": true   shut to every country at war with whoever holds the
//                               ground at the middle of the line (or at "holder")
//   "closes_to_belligerents": true
//                               shut besides to every country at war with anybody, unless
//                               the holder fights on its side - the Montreux Convention
//   "open": false               shut outright - how a mod closes a canal
//
// A mod adds a passage by adding a key, and changes one by naming it again.
{
  "suez_canal": {
    "name": "Suez Canal",
    "closes_to_enemies": true,
    "points": [[31.35, 32.32], [30.95, 32.31], [30.60, 32.29], [30.25, 32.45], [29.93, 32.55], [29.40, 32.70], [28.70, 33.10], [28.30, 33.30]]
  },
