  "ambazonia_interim_government": {"tag": "ABZ", "name": "Ambazonia Interim Government", "description": "The anglophone Cameroonians' movement, born of 2016 lawyer and teacher protests against the imposition of French in courts and schools, declaring independence of the former British Southern Cameroons a year later. The separatist camp is divided among rival administrations and armed self-defence groups; the state's answer has been a curfew, burned villages and a war almost nobody outside the region names.", "colour": "#4f6a8f", "peoples": ["english"], "faiths": ["protestant"], "headquarters": "cm_nw", "homeland": ["cm_nw", "cm_sw"], "support": {"cm_nw": 0.22, "cm_sw": 0.26}, "treasury": 0.02, "cadres": 4000, "legitimacy": 0.14, "government": "provisional_government", "ideology": "nationalism", "state_name": "Ambazonia", "traits": ["armed_wing", "diaspora_lobby"]},
  "catalan_civic_campaign": {"tag": "CCC", "name": "Catalan Civic Campaign", "description": "The organised independence movement of Catalonia as it acts in the open: the assemblies, the annual demonstration that fills the city on the Diada, the parties and associations that turned a question of statute reform into a question of a republic. Its referendum of 2017 was illegal under the Spanish constitution and binding for a generation of its voters at the same time.", "colour": "#a04f4f", "peoples": ["catalan"], "headquarters": "es_ca", "homeland": ["es_ca"], "support": {"es_ca": 0.35, "es_ba": 0.06}, "treasury": 0.03, "cadres": 4000, "legitimacy": 0.16, "government": "parliamentary_republic", "ideology": "nationalism", "state_name": "Catalonia", "traits": ["nonviolence", "mass_movement", "diaspora_lobby"]},
  "kanak_socialist_front": {"tag": "KSF", "name": "Kanak Socialist Front", "description": "The Kanak independence movement of New Caledonia, heir of the FLNKS: three referendums against French sovereignty, two won by staying, the third boycotted after the elder statesmen asked for a mourning year and were refused. The 2024 riots burned what the ballot did not settle, and the question of who may vote - and who was never asked - is again the whole question.", "colour": "#3f8f6a", "peoples": ["kanak"], "headquarters": "nc_x03", "homeland": ["nc_x03"], "support": {"nc_x03": 0.4}, "treasury": 0.02, "cadres": 1500, "legitimacy": 0.2, "government": "parliamentary_republic", "ideology": "socialism", "state_name": "Kanaky", "traits": ["mass_movement", "nonviolence"]}
