// Three more movements of the real world in 2024 that hold no state of their own.
//
// The fields are described at the top of 00_movements.json. Descriptions say what each movement is
// and who calls it what; they take no side, as the older file's do.
//
// What is chosen, and how, matters more here than the count:
//
//   peoples  Every movement speaks for peoples the game's own region data actually has in its
//            homeland, because support, donations and cadres come from those peoples and a
//            movement whose people are not in the region can never gain any. Rakhine is 30 %
//            Rohingya (history/states/2024/MMR.json), Papua is 83 % Papuan, Arauca is 85 %
//            Colombian. A movement that would need a people the region data does not model - the
//            Ta'ang of Shan State, for instance, who are absent from that region's cultures - is
//            not in this file, because adding it would mean inventing a people rather than
//            describing a movement.
//
//   headquarters / homeland / support
//            Region ids as the game uses them. A wrong one is not an error anywhere: the movement
//            is simply never founded, or a support entry is simply ignored. MovementCatalogTests
//            therefore checks that every movement in the catalogue is founded in a fresh campaign
//            and that every region it names is honoured.
//
//   government / ideology / traits
//            Only ids and traits the older file already uses, so nothing new has to be invented to
//            read this one.
{
  // Rakhine, Myanmar. The Rohingya armed group of 2016-2017, whose attacks and the military's
  // response emptied the north of the state: more than seven hundred thousand people crossed into
  // Bangladesh. It has had little armed presence inside Myanmar since, and works from the camps
  // and the diaspora instead - which is what it is in this file.
  "arsa": {"tag": "ARS", "name": "Arakan Rohingya Salvation Army", "description": "The Rohingya armed group whose attacks on police posts in northern Rakhine in 2016 and 2017 were answered by a military campaign that drove more than 700,000 Rohingya into Bangladesh. Myanmar's government declared it a terrorist organisation, and it has had little armed presence inside the country since, working from the refugee camps and the diaspora.", "colour": "#2f7f4f", "peoples": ["rohingya"], "faiths": ["sunni"], "headquarters": "mm_16", "homeland": ["mm_16"], "support": {"mm_16": 0.1}, "treasury": 0.01, "cadres": 1200, "legitimacy": 0.08, "government": "provisional_government", "ideology": "nationalism", "state_name": "Arakan", "traits": ["armed_wing", "diaspora_lobby"]},

  // The highlands of Papua and West Papua, Indonesia. The armed wing of the United Liberation
  // Movement for West Papua, which replaced the older OPM structures: it attacks Indonesian
  // soldiers, police and mine workers, and the movement it belongs to is heard more in Pacific
  // capitals than in the highlands. Indonesia calls it a separatist and terrorist organisation.
  "tpnpb": {"tag": "TPN", "name": "West Papua National Liberation Army", "description": "The armed wing of the United Liberation Movement for West Papua, which took over from the older Free Papua Movement. It attacks Indonesian soldiers, police and workers at the Grasberg mine, mostly in the highlands of Papua and West Papua provinces, and Indonesia classifies it as a separatist and terrorist organisation. Its political wing is heard more in Pacific capitals, where the Melanesian Spearhead Group and several states receive it, than in the highlands themselves.", "colour": "#c8402f", "peoples": ["papuan"], "faiths": ["other_christian"], "headquarters": "id_pa", "homeland": ["id_pa", "id_pb"], "support": {"id_pa": 0.16, "id_pb": 0.14}, "treasury": 0.01, "cadres": 2500, "legitimacy": 0.15, "government": "provisional_government", "ideology": "nationalism", "state_name": "West Papua", "traits": ["armed_wing", "diaspora_lobby"]},

  // Arauca and the Colombian-Venezuelan border. The country's oldest and, since the FARC laid down
  // its arms, its largest guerrilla: it is in talks with the government of Gustavo Petro, with a
  // ceasefire that has been renewed and broken, and it lives off kidnapping, extortion and the
  // drug trade. Unlike the other two it does not want a state of its own - it wants Colombia.
  "eln": {"tag": "ELN", "name": "National Liberation Army", "description": "Colombia's oldest guerrilla, founded in 1964 and, since the FARC demobilised, its largest. It is in negotiations with the government of Gustavo Petro under a ceasefire that has been renewed and broken, and it lives off kidnapping, extortion and the drug trade in Arauca, Norte de Santander, Cauca and Choco. Colombia, the United States and the European Union list it as a terrorist organisation.", "colour": "#b03030", "peoples": ["colombian"], "faiths": ["other_christian"], "headquarters": "co_ara", "homeland": ["co_ara", "co_nsa", "co_cau", "co_cho"], "support": {"co_ara": 0.12, "co_nsa": 0.1, "co_cau": 0.08, "co_cho": 0.08}, "treasury": 0.04, "cadres": 6000, "legitimacy": 0.1, "government": "provisional_government", "ideology": "socialism", "state_name": "Colombia", "traits": ["armed_wing"]},

  // Kidal and the northern desert of Mali. The Tuareg and Arab alliance fighting for self-determination
  // in Azawad: resumed hostilities in 2023 after the withdrawal of MINUSMA and the Malian army's advance.
  "cma": {"tag": "CMA", "name": "Coordination of Azawad Movements", "description": "The coalition of Tuareg and Arab movements formed in 2014 to seek autonomy and self-determination for Azawad in northern Mali. Following the breakdown of the 2015 Algiers Accord and the withdrawal of UN peacekeepers in 2023, it resumed armed resistance against the central government in Bamako.", "colour": "#8a7a3b", "peoples": ["tuareg", "songhai"], "faiths": ["sunni"], "headquarters": "ml_8", "homeland": ["ml_8", "ml_7", "ml_6"], "support": {"ml_8": 0.4, "ml_7": 0.15, "ml_6": 0.1}, "treasury": 0.03, "cadres": 6000, "legitimacy": 0.18, "government": "provisional_government", "ideology": "nationalism", "state_name": "Azawad", "traits": ["armed_wing", "diaspora_lobby"]},

  // North and East Syria. The multi-ethnic alliance led by the Kurdish YPG and allied Arab and Syriac
  // brigades, defending the autonomous region of Rojava against external intervention and sleeper cells.
  "sdf": {"tag": "SDF", "name": "Syrian Democratic Forces", "description": "The multi-ethnic military and civil coalition formed in 2015, uniting the Kurdish People's Protection Units (YPG) with Arab, Syriac and Turkmen forces. It administers the Autonomous Administration of North and East Syria, maintaining frontline defense and managing regional institutions.", "colour": "#f0c020", "peoples": ["kurdish", "arab_levantine"], "faiths": ["sunni"], "headquarters": "sy_ha", "homeland": ["sy_ha", "sy_ra", "sy_dy"], "support": {"sy_ha": 0.35, "sy_ra": 0.18, "sy_dy": 0.12}, "treasury": 0.08, "cadres": 22000, "legitimacy": 0.3, "government": "provisional_government", "ideology": "socialism", "state_name": "Rojava", "traits": ["armed_wing", "diaspora_lobby", "government_partner"]},

  // Western Yemen and the Red Sea corridor. The Zaydi Shia movement ruling Sana'a and the highlands,
  // blockading Bab-el-Mandeb maritime shipping and confronting the Saudi-led coalition.
  "ansar_allah": {"tag": "HOU", "territorial_faction": "ansar_allah", "name": "Ansar Allah", "description": "The Zaydi political and military movement founded by Hussein Badreddin al-Houthi in the 1990s. Controlling Sana'a, the northern highlands, and the Red Sea port of Hudaydah, it maintains sovereign administration over much of western Yemen and conducts maritime interdiction operations across the Bab-el-Mandeb strait.", "colour": "#2c6330", "peoples": ["arab_yemeni"], "faiths": ["shia"], "headquarters": "ye_sn", "homeland": ["ye_sn", "ye_sd", "ye_hu", "ye_hj", "ye_dh"], "support": {"ye_sn": 0.45, "ye_sd": 0.55, "ye_hu": 0.35, "ye_hj": 0.35, "ye_dh": 0.35}, "treasury": 0.1, "cadres": 35000, "legitimacy": 0.25, "government": "theocracy", "ideology": "theocratic_rule", "state_name": "Yemen", "traits": ["armed_wing", "mass_movement", "government_partner"]},

  // Lebanon and the Beqaa Valley. The Shia political party and paramilitary organisation commanding
  // autonomous rocket brigades, extensive social institutions, and cabinet seats in Beirut.
  "hezbollah": {"tag": "HZB", "name": "Hezbollah", "description": "The Lebanese Shia political party and paramilitary organisation founded during the Lebanese Civil War. It fields an extensive rocket arsenal and militia forces in southern Lebanon and the Beqaa Valley, exercising decisive military influence and participating in the Lebanese parliament and cabinet.", "colour": "#f0c800", "peoples": ["arab_levantine"], "faiths": ["shia"], "headquarters": "lb_bi", "homeland": ["lb_bi"], "support": {"lb_bi": 0.35}, "treasury": 0.12, "cadres": 25000, "legitimacy": 0.25, "government": "provisional_government", "ideology": "theocratic_rule", "state_name": "Lebanon", "traits": ["armed_wing", "mass_movement", "government_partner"]},

  // Rakhine State and western Myanmar. The armed wing of the United League of Arakan (ULA),
  // fighting for the self-determination of the Rakhine people, key member of the Three Brotherhood
  // Alliance in Operation 1027, controlling rural districts, border trade routes and regional hubs.
  "arakan_army": {"tag": "ARA", "name": "Arakan Army", "description": "The ethnic armed organisation founded in 2009 as the military wing of the United League of Arakan. Operating primarily in Rakhine and southern Chin State, it formed the Three Brotherhood Alliance and took control of extensive territory, border gates, and administrative hubs across western Myanmar.", "colour": "#e63946", "peoples": ["rakhine", "burmese"], "faiths": ["theravada"], "headquarters": "mm_16", "homeland": ["mm_16", "mm_14"], "support": {"mm_16": 0.45, "mm_14": 0.08}, "treasury": 0.06, "cadres": 30000, "legitimacy": 0.35, "government": "provisional_government", "ideology": "nationalism", "state_name": "Arakan", "traits": ["armed_wing", "diaspora_lobby"]}
}
