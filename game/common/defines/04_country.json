// Deal or Force - Country, economy and nationality.
//
// Every key here overrides the value compiled into Defines.cs. A key no file mentions
// keeps its compiled value, so a balance mod only lists what it changes.
//
// This whole folder is read, in file-name order, and later files win. That is why the
// base game's own files are numbered: a mod drops `50_my_balance.json` in beside them,
// changes three numbers, and inherits everything else. It never has to fork this file.
//
// SimBench checks that what ships here still agrees with the compiled defaults - a stale
// data file silently undid an entire combat rebalance once, because data wins over code
// by design and nothing was watching.
{

  // Everything else
  "InlandWaterworksYield": 0.45,
  "DemolitionRefund": 0.25,
  "PeaceRoundUpShare": 0.50,
  "PeaceRoundDownShare": 0.50,
  // false: every treaty takes the provinces it names, part of a region at a time (campaign option "Peace by provinces").
  "PeaceWholeRegions": true,
  // Ambient popups: 125 days instead of 75 = 40% fewer over a long campaign.
  // <= 0 disables ambient draws only. Secession/union/scripted requests still work.
  "EventIntervalDays": 125,
  // Landless human movements: -1 inherits the interval above, 0 disables, >0 overrides.
  "MovementEventIntervalDays": -1,
  "EventMemoryDays": 1460,
  "EventExpiryDays": 182,
  "MaxConstructionProjects": 12,
  "SeedPeoplePerFarm": 3200000,
  "SeedUrbanPeoplePerIndustry": 10500000,
  "SeedInfrastructurePerUrbanisation": 4,
  "PeaceExhaustionWeight": 42,
  "PeaceTimePressureDays": 25,
  "PeaceTimePressureCap": 18,
  "ScarcityTolerance": 0.06,
  "EconomyTickDays": 7,
  "PopulationTickDays": 30,
  "AutosaveIntervalDays": 30,
  // Never two autosaves inside this many real seconds, whatever the calendar says: at the
  // top speed thirty days is a second and a half.
  "AutosaveMinimumSeconds": 120,
  "SaveTextFormat": false,
  // Diagnostics only: walk every object in the snapshot before writing. Off because the
  // weekly live-integrity gate plus the serializer's own refusal of NaN/Infinity already
  // protect the last good save, and the full walk costs more than writing the file.
  "SaveDeepIntegrity": false,
  "SecondsPerDay": 5,
  "GlobeRadius": 2600,
  "LandRelief": 26,
  "ReliefScale": 1.6,
  "OceanReliefEnabled": false,
  "OceanTilesX": 48,
  "OceanTilesY": 24,
  "OceanSurfaceOffset": 2.5,
  "MapBrightness": 0.92,
  "MapSaturation": 1.35,
  "MapCountryBorder": 0.66,
  "MapStateBorder": 0.30,
  "PopulationPerAreaUnit": 320000,
  "PriceAdjustSpeed": 0.25,
  "WorldMarketAccess": 0.80,
  "ImportMarkup": 1.06,
  "MarketTreasuryTradeShare": 0.08,
  // Households buy more as the country's real output per head rises above where it began: demand
  // terms written with "income" in common/production grow to this power, within these bounds.
  "IncomeDemandElasticity": 0.85,
  "IncomeFactorMinimum": 0.5,
  "IncomeFactorMaximum": 3,
  // Diminishing returns to capital: up to CapitalDeepeningHeadroom times the jobs per worker its
  // buildings first asked for, every building adds its full output; past it the plant as a whole
  // yields as its size to CapitalDeepeningShare. 0 turns them off.
  "CapitalDeepeningHeadroom": 1.3,
  "CapitalDeepeningShare": 0.4,
  "ShortageAnnualGrowthPenalty": 0.08,
  "GdpConvergenceRate": 0.10,
  // Days at the start in which GDP holds the scenario's figures while trade and prices settle.
  "OutputSpinUpDays": 182,
  "ShortageSolWeeklyPenalty": 0.004,
  "DebtInterest": 0.0008,
  "DebtRepayment": 0.15,
  "BankruptcyUnrest": 0.02,
  "WageShare": 0.62,
  "SubsistenceWage": 60,
  "SubsistenceIncome": 25,
  "MaxStandardOfLiving": 28,
  "MaxMonthlyGrowth": 0.006,
  "MaxMonthlyDecline": 0.004,
  "MobilityRate": 0.035,
  "RadicalismGain": 0.05,
  "RadicalismDecay": 0.03,
  "StartingTreasury": 5000000000,
  "DefaultTaxRate": 0.21,
  // What a country history/countries says nothing about opens with, as a share of its yearly
  // income, and what one whose income is unknown is assumed to earn per head. Both are
  // fallbacks: a country that states a treasury or a GDP in history keeps its own figure, and
  // the base game's Korea states a treasury.
  "BaseTreasuryGdpShare": 0.10,
  "MicrostateGdpPerHead": 15,
  "BuildingUpkeep": 18000,
  "ConstructionRate": 0.008,
  "MilitaryEligibleShare": 0.42,
  "WorkingAgeShare": 0.63,
  "DivisionUpkeep": 2600000,
  "HullUpkeep": 1100000,
  "BaselineMilitarySpending": 0.06,
  "NavalResponse": 1,

  // Nationality: what a moved border leaves behind
  "MinorityRadicalismPerWeek": 0.0012,

  // The capital. Moving it by choice costs CapitalMoveCostShare of GDP (never less than the
  // floor) and CapitalMoveStabilityCost of settledness, and the government cannot move again
  // for CapitalMoveIntervalDays. A country that loses the ground its capital stands on moves
  // for nothing, to the most populous region it has left.
  "CapitalMoveCostShare": 0.0015,
  "CapitalMoveCostFloor": 0.05,
  "CapitalMoveStabilityCost": 0.02,
  "CapitalMoveIntervalDays": 365
}
