// Мобилизация и послевоенный роспуск. Всё, чем война набирает и распускает армию,
// в одном файле, чтобы баланс был правкой данных, а не кода.
//
// ArmyWarCeiling            потолок армии в войне в долях мирного штата: долгий фронт
//                           требует больше, чем двойной мирный состав, иначе дыры на
//                           линии нечем закрыть в принципе;
// ArmyWartimeRaiseBatch     сколько формирований за один взгляд поднимает страна, которой
//                           не хватает до потребности фронта (не считая перебиваемой
//                           страны — у неё свой ArmyEmergencyRaises);
// ArmyPeaceDisbandMargin    насколько выше мирного штата армия может оставаться после
//                           войны, прежде чем по одной формировании пойдут по домам;
// RecruitmentBatchCap       очередь подготовки в мирное время (партий);
// RecruitmentWartimeBatchCap очередь подготовки в войну: школы работают в две смены.
{
  "ArmyWarCeiling": 2.5,
  "ArmyWartimeRaiseBatch": 3,
  "ArmyPeaceDisbandMargin": 1.05,
  "RecruitmentBatchCap": 12,
  "RecruitmentWartimeBatchCap": 24
}
