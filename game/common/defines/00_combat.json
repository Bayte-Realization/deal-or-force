// Deal or Force - Combat.
//
// Every key here overrides the value compiled into Defines.cs. A key no file mentions
// keeps its compiled value, so a balance mod only lists what it changes.
//
// This whole folder is read, in file-name order, and later files win. That is why the
// base game's own files are numbered: a mod drops `50_my_balance.json` in beside them,
// changes three numbers, and inherits everything else. It never has to fork this file.
//
// SimBench checks that what ships here still agrees with the compiled defaults - a stale
// data file silently undid an entire combat rebalance once, because data wins over code
// by design and nothing was watching.
{

  // Combat
  "DefenderAdvantage": 2.50,
  "HomelandDefenseBonus": 1.25,
  "CapitalDefenseBonus": 1.20,
  "FrontalDefenseBonus": 1.25,
  "EntrenchmentShellingResistance": 0.60,
  "BreakthroughEntrenchmentResistance": 0.70,
  "UrbanBreakthroughPenalty": 0.50,
  "CombatWidth": 80,
  "CombatWidthPerDirection": 20,
  "MaxAttackDirections": 4,
  "OverWidthPenalty": 0.9,
  "MinCrowdingFactor": 0.45,
  "DefenderCounterFire": 1.00,
  "UnpiercedDamageFloor": 0.5,
  "BaseOrganisationDamage": 0.048,
  "MinOrganisationDamage": 0.010,
  "MaxOrganisationDamage": 0.130,
  // A third of what it was: at 0.075 Russia lost 1.8 million men in 2024 and Ukraine 0.7 million,
  // four times the Western estimates (some 430 000 Russian dead and wounded), and the side that
  // attacked bled itself out of the war. At 0.025 the year costs Russia about 0.55 million.
  "CasualtiesPerOrganisationPoint": 0.025,
  "BrokenCasualtyMultiplier": 2.4,
  "AttackerCasualtyMultiplier": 2.4,
  "EntrenchmentBonus": 1.80,
  "EntrenchmentPerDay": 0.045,
  "EntrenchmentAtScenarioStart": 0.85,
  "EntrenchmentLostPerCombatDay": 0.020,
  "EntrenchmentUnderFireShare": 0.75,
  "BattleBreakOrganisation": 0.055,

  // Movement, ground and fronts
  "MobilisationBaseShare": 0.060,
  "ManpowerReserveFloorShare": 0.15,
  "ReinforcementCapacityShare": 0.0010,

  "UnopposedCapturePerDay": 0.10,
  "ZoneOfControlResistance": 6.0,
  "GapExploitAdvantage": 1.60,

  // What a formation the player ordered forward by hand may be slowed to by covering fire,
  // as a share of an advance into open country. The rule above refuses a formation that
  // advanced on its own judgement; an order is made costly instead of refused.
  "OrderedAdvanceFloor": 0.25,
  "CoveringPresenceFloor": 0.45,
  "RestAfterCaptureDays": 2,
  "RestAfterSpentAttackDays": 7,
  "RestAfterRetreatDays": 7,
  // How many provinces deep a beaten formation looks for its own line before surrendering
  // whole. 1 left divisions whose neighbours had all changed hands to surrender with their line
  // two provinces away: 245,000 Ukrainian prisoners by day 300 in one run, 66,000 at 3. Over 24
  // two-year runs Ukraine held 72 provinces (63 at 1).
  "RetreatSearchDepth": 3,
  "FrontCoverageRadius": 2,
  "FrontCoverageFalloff": 0.45,
  "WoundedReturningShare": 0.55,
  "WoundedReturnPerDay": 0.020,
  "WoundedReturnMinimumSupply": 0.22,
  "WoundedLostWhenUnsuppliedPerDay": 0.030,
  "WartimeFrontDeploymentShare": 0.84,
  "PeacetimeBorderDeploymentShare": 0.68,
  "RiverMovementMultiplier": 0.78,
  "RiverAttackMultiplier": 0.82,
  "MajorRiverAttackMultiplier": 0.70,
  "LakeSupplyBonus": 0.08,

  // Planning
  "PlanningGainPerDay": 0.018,
  "PlanningLossPerProvince": 0.025,
  "PlanningBurnPerCombatDay": 0.055,
  "MaxPlanningAttackBonus": 0.30,

  // Long-range forces: how much the guns, aircraft and drones a country reaches with
  // add to the battles inside their radius - and how much of the enemy's contribution
  // the sky over the ground takes away. Saturating fractions, never cliffs.
  "MaxSupportFireBonus": 0.30,
  "SupportFireSaturation": 8.0,
  "MaxSupportInterdiction": 0.25,
  "InterdictionSaturation": 12.0,
  "AirSuppressionPerPoint": 0.02,
  "SupportRegenPerDay": 0.005,

  // Pockets. A formation cut off from supply loses strength and organisation every day it
  // stays cut off - faster while it is also being attacked - and takes more from the same
  // fire, because nothing reaches it and it has nowhere to fall back to. Of what a starving
  // pocket loses, EncircledLossCapturedShare surrender and the rest die. When it breaks,
  // what is left of it surrenders: SurrenderKilledShare of them die in the last of it, the
  // rest are taken, and so are the wounded it was carrying.
  "DivisionBrokenStrength": 0.06,
  "EncircledStrengthLoss": 0.022,
  "EncircledOrganisationLoss": 0.035,
  "EncircledUnderAttack": 1.8,
  "EncircledCasualtyMultiplier": 1.5,
  "EncircledLossCapturedShare": 0.45,
  "SurrenderKilledShare": 0.12,

  // Losses and prisoners. Of a day's casualties, WoundedShareOfCasualties are wounded and
  // the rest killed; WoundedReturningShare above is how many of the same casualties come
  // back to their formation, so it can be no larger. Prisoners go home by an exchange -
  // one for one, at most every PrisonerExchangeIntervalDays - or at the peace, and
  // PrisonersRepatriatedShare of them survive captivity to do it.
  "WoundedShareOfCasualties": 0.75,
  "PrisonersRepatriatedShare": 0.92,
  "PrisonerExchangeMinimum": 500,
  "PrisonerExchangeIntervalDays": 30,

  // Operational tempo (CombatTempo.cs). A prepared and supplied attack with local
  // superiority can break organisation faster instead of only grinding; a dug-in,
  // supplied defence can turn a spent attack back. These are bounded fractions, not
  // free victories: below the pressure floors both stay at zero.
  "BreakthroughPressureFloor": 1.35,
  "BreakthroughPressureSpan": 1.75,
  "BreakthroughPlanningFloor": 0.35,
  "BreakthroughSupplyFloor": 0.45,
  "BreakthroughOrganisationBonus": 0.45,
  "BreakthroughAttackerRelief": 0.18,
  "CounterattackPressureFloor": 1.15,
  "CounterattackPressureSpan": 1.50,
  "CounterattackEntrenchmentFloor": 0.40,
  "CounterattackSupplyFloor": 0.45,
  "CounterattackOrganisationBonus": 0.50,
  "CounterattackDefenderRelief": 0.20,
  "CounterattackVulnerabilityWeight": 1.50,
  "DesperateCounterattackBonus": 0.30
}
