// Deal or Force - Peace conference.
//
// Every key here overrides the value compiled into Defines.cs. A key no file mentions
// keeps its compiled value, so a balance mod only lists what it changes.
//
// This whole folder is read, in file-name order, and later files win. That is why the
// base game's own files are numbered: a mod drops `50_my_balance.json` in beside them,
// changes three numbers, and inherits everything else. It never has to fork this file.
//
// SimBench checks that what ships here still agrees with the compiled defaults - a stale
// data file silently undid an entire combat rebalance once, because data wins over code
// by design and nothing was watching.
{

  // Peace conference: what a demand costs
  "PeaceCostPerProvince": 0.9,
  "PeaceCostSecuredFactor": 1.0,
  "PeaceCostHeldFactor": 1.8,
  "PeaceCostUnheldFactor": 4.5,
  // A province the winner cannot walk to from what it owns - an enclave in the making. Priced,
  // not banned: exclusive islands exist, and a state writing back its own civil-war ground is
  // never charged this (PeaceLedger.DetachedFromBeneficiary).
  "PeaceCostDetachedFactor": 2.2,
  "PeaceCostWarGoalFactor": 0.65,
  "PeaceCostCapitalFactor": 2.6,
  "PeaceCostPopulationScale": 400000,
  "PeaceCostReparations": 14,
  "PeaceCostTradeConcessions": 11,
  "PeaceCostDemilitarise": 22,
  "PeaceCostHumiliate": 26,
  "PeaceCostLongTruce": 9
}
