// Deal or Force - Supply, occupation and war score.
//
// Every key here overrides the value compiled into Defines.cs. A key no file mentions
// keeps its compiled value, so a balance mod only lists what it changes.
//
// This whole folder is read, in file-name order, and later files win. That is why the
// base game's own files are numbered: a mod drops `50_my_balance.json` in beside them,
// changes three numbers, and inherits everything else. It never has to fork this file.
//
// SimBench checks that what ships here still agrees with the compiled defaults - a stale
// data file silently undid an entire combat rebalance once, because data wins over code
// by design and nothing was watching.
{

  // Supply
  "SupplyTraceRange": 20,
  // Days a cut-off grouping lives on what it carried before supply and organisation are spent.
  "SupplyCutoffDays": 14,
  // Staff attacks wait while recorded ammunition or oil cover is under this share of yesterday's draw.
  // 0 turns the wait off. A direct order is not waiting on it.
  "SupplyAttackCoverageFloor": 0.5,
  "BaseStateSupplyThroughput": 6,
  "SupplyThroughputPerDivision": 0.12,
  "SupplyPerInfrastructure": 2.2,
  "SupplyPerBarracks": 0.9,

  // Occupation and war score
  "OccupationDailyProgress": 0.012,
  "OccupationSecureThreshold": 0.70,
  "WarScoreForVictory": 55,
  "WarSupportForCapitulation": 0.18
}
