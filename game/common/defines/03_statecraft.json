// Deal or Force - Statecraft and the AI.
//
// Every key here overrides the value compiled into Defines.cs. A key no file mentions
// keeps its compiled value, so a balance mod only lists what it changes.
//
// This whole folder is read, in file-name order, and later files win. That is why the
// base game's own files are numbered: a mod drops `50_my_balance.json` in beside them,
// changes three numbers, and inherits everything else. It never has to fork this file.
//
// SimBench checks that what ships here still agrees with the compiled defaults - a stale
// data file silently undid an entire combat rebalance once, because data wins over code
// by design and nothing was watching.
{

  // Statecraft: how a country governs itself and reads its neighbours
  // Raised from 0.012, which measured as a system that did not do what it says: five years of the
  // world gave 160 wars worth having and ONE declaration. At 0.05 it declares four times and fights
  // sixteen wars, fourteen of which end - and at 0.15 the world is identical to 0.05, so this is
  // the knee of the curve. Keep this in step with Defines.AiWarChance; SimBench holds the two to
  // each other, and a stale file here silently undid a whole rebalance once.
  "AiWarChance": 0.05,
  "AiMayDeclareWar": true,
  "AiBorderFriction": -6,
  "AiTradeWarmth": 28,
  "AiPactWarmth": 22,
  "AiAllianceWarmth": 34,
  "AiFearOfStrength": 16,
  "AiOpinionDrift": 0.10,
  "AiCourtshipStep": 6,
  "AiFriendshipThreshold": 10,
  "AiTradeThreshold": 18,
  "AiPactThreshold": 42,
  "AiAllianceThreshold": 66,

  // How many countries everybody has an opinion about, whether they border them or
  // not. Set it to nought and diplomacy is between neighbours again.
  "AiGreatPowers": 12,

  // A small country frightened of a large neighbour asks somebody larger still to
  // stand behind it. How much stronger the neighbour has to be before it asks, what
  // the request has to be worth to be granted, and what it is worth that the country
  // being asked is wary of the same neighbour.
  "AiCounterweightFear": 1.15,
  "AiShelterWillingness": 0.20,
  "AiShelterSharedRival": 0.50,
  "AiShelterWarPenalty": 0.35,

  // An alliance is asked for and answered - see AllianceCore. What an offer has to be
  // worth, how long one put to a player stands, how long a refusal is remembered, and the
  // four things a country weighs when it is asked.
  "AllianceWillingness": 0.5,
  "AllianceOfferDays": 30,
  "AllianceRefusalDays": 180,
  "AllianceWarPenalty": 0.45,
  "AllianceShelterWeight": 0.30,
  "AllianceNotorietyWeight": 0.40,
  "AllianceSharedRivalWeight": 0.12,
  "AiRivalryThreshold": -30,
  "AiTreasuryFloor": 0.02,
  "AiTreasuryComfort": 0.12,
  "AiTaxStep": 0.012,
  "AiMinimumTaxRate": 0.08,
  "AiMaximumTaxRate": 0.46,
  "AiWartimeMilitarySpending": 0.16,
  "AiTenseMilitarySpending": 0.09,
  "AiPeacetimeMilitarySpending": 0.045,
  "AiWartimeArmsFocus": 0.40,
  "AiPeacetimeArmsFocus": 0.04,
  "AiStabilityConcern": 0.52,
  "AiSocialStep": 0.006,
  "AiBuildTreasuryFloor": 0.01,
  "AiMaxConcurrentProjects": 4,
  "AiBuildSaturation": 2.5,
  "AiEconomicWeight": 0.004,
  "AiWarMinimumAdvantage": 1.45,
  "AiHostilityAppetite": 1.2,
  "AiRivalryAppetite": 0.8,
  "AiOpportunismAppetite": 1.1,
  "AiUnfinishedGoalAppetite": 0.90,
  "AiTargetExhaustionWarSupport": 0.45,
  "AiTargetExhaustionStability": 0.50,
  "AiTargetExhaustionMultiplier": 0.85,
  "AiWarDesireThreshold": 0.55,
  "AiWarSupportFloor": 0.45,
  "AiWarStabilityFloor": 0.35,
  "AiMinimumWarDays": 240,
  "ScenarioWarNegotiationLockDays": 1095,
  "AiPeaceProposalInterval": 45,
  "AiPeaceMinimumBudget": 35,
  "AiPeaceIndemnityBudget": 55,
  "AiCapitulationWarSupport": 0.30,
  "AiPeaceBudgetShare": 0.85,
  "AiMayAttackPlayer": true,

  // An ally or a guarantor may put cash on the deal table when a client's institutions
  // are failing. A player still signs. Off spends that week on ordinary courtship.
  "AiCrisisGrants": true,
  "AiCrisisGrantRetryDays": 360
}
