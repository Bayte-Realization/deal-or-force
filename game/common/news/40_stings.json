// The short sound a headline makes when it reaches the rail beside the map.
//
// A kind of news names a cue from sound/ (05_news.json has the base game's). Only news the
// rail would show sounds - important enough, or about the player's own country - and never
// the player's own act, which already has its own sound. `sting_gap_ms` is the least time
// between two stings, whatever their cues, so a busy day is one sound and not a drum roll.
// A mod names its own kinds here, points a kind at a cue of its own, or silences one with "".
{
  "sting_gap_ms": 9000,
  "stings": {
    "coup": "news_coup",
    "nuclear_strike": "news_nuclear_detonation",
    "nuclear_retaliation": "news_nuclear_detonation",
    "mass_protests": "news_strike",
    "coup_counter": "news_coup",
    "institutional_coup": "news_coup",
    "regime_change": "news_regime_change",
    "march_toppled": "news_regime_change",
    "ruler_changed": "news_regime_change",
    "election_lost": "news_election",
    "election_transfer": "news_election",
    "election_renewed": "news_election",
    "election_suspended": "news_election",
    "election_postponed": "news_election",
    "general_strike": "news_strike",
    "anti_war_protests": "news_strike",
    "march_concessions": "news_strike",
    "political_scandal": "news_scandal",
    "spy_network_exposed": "news_scandal",
    "covert_sabotage_exposed": "news_scandal",
    "covert_opposition_exposed": "news_scandal",
    "covert_theft_exposed": "news_scandal",
    "peace_signed": "news_treaty",
    "accession_signed": "news_treaty",
    "deal_signed": "news_treaty",
    "debt_restructured": "news_treaty",
    "tension_eased": "news_treaty",
    "state_formed": "news_new_nation",
