// Why one country feels the way it does about another.
//
// Opinion is the sum of these, not a number anybody sets. A reason has a size, a lifetime
// in days, and whether it fades over that lifetime or holds at full weight until it is
// taken away. `max_stacks` is how many times the same thing can be counted - a second
// denunciation stings again, a fifth does not.
//
// days: 0 means it is held for as long as whatever caused it lasts.
{
  "improved_relations": {
    "name": "Recent diplomacy",
    "opinion": 12,
    "days": 900,
    "decays": true,
    "max_stacks": 4
  },

  // Minus fifteen, so that two denunciations still add up to a grievance worth a war
  // (CasusBelliGrudgeFloor, minus thirty) and one does not; remembered for two years.
  "denounced": {
    "name": "Denounced us publicly",
    "opinion": -15,
    "days": 730,
    "decays": true,
    "max_stacks": 3
  },

  // A war is the thing a country remembers longest, and the thing that fades slowest -
  // ten years, and only then is it gone. Before this an opinion set to minus sixty by a
  // war in 2024 was still minus sixty in 2124.
  "declared_war_on_us": {
    "name": "Declared war on us",
    "opinion": -60,
    "days": 3650,
    "decays": true,
    "max_stacks": 2
  },

  "fought_a_war": {
    "name": "We have fought",
    "opinion": -25,
    "days": 2200,
    "decays": true,
    "max_stacks": 3
  },

  "made_peace": {
    "name": "Settled it without rancour",
    "opinion": 10,
    "days": 1460,
    "decays": true
  },

  "took_our_land": {
    "name": "Took our land",
    "opinion": -45,
    "days": 7300,
    "decays": true,
    "max_stacks": 3
  },

  "unfinished_war_claim": {
    "name": "Unfinished war claims",
    "opinion": -30,
    "days": 3650,
    "decays": true,
    "max_stacks": 2
  },

  // Standing conditions: held at full weight while they are true, forgotten the day they
  // are not. These five used to be numbers in Defines.cs that the AI lerped an opinion
  // towards - real, and invisible, and untouchable by a mod.
  "trade_agreement": {
    "name": "Trade agreement",
    "opinion": 28,
    "days": 0,
    "decays": false
  },

  "non_aggression_pact": {
    "name": "Non-aggression pact",
    "opinion": 22,
    "days": 0,
    "decays": false
  },

  "alliance": {
    "name": "Allied",
    "opinion": 34,
    "days": 0,
    "decays": false
  },

  "shared_border": {
    "name": "We share a border",
    "opinion": -6,
    "days": 0,
    "decays": false
  },

  // Held while it lasts and forgotten the day nobody is refusing any more - lifted by an
  // organisation's vote, it used never to be forgotten at all. Kept at minus thirty because an
  // embargo is a direct act against the country embargoed, and exactly the depth of grudge a
  // war may be declared over (CasusBelliGrudgeFloor).
  "embargoed_us": {
    "name": "Refuses to trade with us",
    "opinion": -30,
    "days": 0,
    "decays": false
  },

  "guaranteed_us": {
    "name": "Has guaranteed our independence",
    "opinion": 26,
    "days": 0,
    "decays": false
  },

  // What the world thinks of a country that keeps taking things. Scaled by how much it has
  // taken, held while it is still notorious, and forgotten when it is not - and scaled again by
  // how much that appetite concerns the country watching (OpinionWitnesses): its neighbours in
  // full, its allies hardly, the far side of the world a little. A bystander's grievance, so it
  // counts towards the ceiling on those (ThirdPartyOpinionFloor). Minus thirty is still exactly
  // the depth of grudge a neighbour may go to war over (CasusBelliGrudgeFloor).
  "notoriety": {
    "name": "Their appetite worries us",
    "opinion": -30,
    "days": 0,
    "decays": false,
    "third_party": true
  },

  "stood_by_us": {
    "name": "Stood by us when it counted",
    "opinion": 45,
    "days": 5500,
    "decays": true,
    "max_stacks": 2
  },

  // Saying no to a war that was never their obligation. A tenth of abandoning somebody and
  // forgotten in three years, because an offensive call is a favour asked and not a promise
  // kept - the alliance survives it, and the next request is heard a little more coldly.
  "refused_a_call": {
    "name": "Would not come when we asked",
    "opinion": -6,
    "days": 1100,
    "decays": true,
    "max_stacks": 3
  },

  "abandoned_us": {
    "name": "Abandoned us when it counted",
    "opinion": -55,
    "days": 5500,
    "decays": true,
    "max_stacks": 2
  },

  // Walking out of an alliance, which is the same promise broken at a cheaper moment than
  // refusing a call to arms - so it costs a third of one and is forgotten in four years
  // rather than fifteen.
  "broke_our_alliance": {
    "name": "Walked out of our alliance",
    "opinion": -18,
    "days": 1460,
    "decays": true,
    "max_stacks": 3
  },

  "coalition_partner": {
    "name": "We are containing the same country",
    "opinion": 20,
    "days": 0,
    "decays": false
  },

  // Scaled by how much bigger the neighbour is - the same fear, felt harder - and by how far
  // away it is (OpinionWitnesses.FearReach): in full next door, hardly at all across the world.
  "fear_of_strength": {
    "name": "They are stronger than us",
    "opinion": -12,
    "days": 0,
    "decays": false
  },

  "shared_state_faith": {
    "name": "Same declared state faith",
    "opinion": 8,
    "days": 0,
    "decays": false
  }
}
