// Курсы, которые оплачиваются опытом, а не деньгами.
//
// Опыт - единственная валюта, которую нельзя одолжить: она накоплена тем, что страна уже
// сделала. Поэтому эти духи висят ограниченный срок: армия проходит курс, знает больше, чем
// знала, и через полгода это становится её обычным уровнем, а не отдельной заслугой.
//
// Решения, которые их выдают, названы в common/decisions/80_doctrine_decisions.json, и каждое
// списывает тот опыт, который курс и даёт.
{
  "intensive_field_course": {
    "name": "Intensive field course",
    "description": "What the army learned by doing is drilled into the men who will do it next: the articles it has read are taught under canvas, with the weather and the distances that go with them.",
    "days": 240,
    "positive": true,
    "effects": {},
    "modifiers": {
      "army_attack": 0.03,
      "organisation_recovery": 0.04
    }
  },
  "airmanship_week": {
