// Which of the world's drawn layers exist in this game (WorldLayers.cs). Every layer is on
// unless a file here says false. A mod set before the age of lorries switches them off by
// shipping its own file in common/world_layers with only the keys it changes:
//
//   { "trade_traffic": false, "supply_lines": false }
//
// The player's switches in the map bar decide what is shown; these decide what exists.
//
//   trade_traffic      ships and lorries on the trade lanes (models in gfx/models/trade)
//   trade_lanes        the dashed lines the trade runs along
//   weather            cloud deck, rain shade, mist and air glow
//   sky_clouds         the photographed cloud layer of the sky
//   ice                the ice shell and sheets of a frozen world
//   event_pulses       the rings that mark news on the map
//   city_labels        city and town names
//   capitals           capital stars
//   country_labels     country names across their territory
//   military_counters  army, fleet and battle counters
//   supply_lines       the selected army's supply line
//
// Mechanics are switched in common/defines (the "Features" table: "navy", "colonisation",
// "secession", "coups", ...), not here.
{
  "trade_traffic": true,
  "trade_lanes": true,
  "weather": true,
  "sky_clouds": true,
  "ice": true,
  "event_pulses": true,
  "city_labels": true,
  "capitals": true,
  "country_labels": true,
  "military_counters": true,
  "supply_lines": true
}
