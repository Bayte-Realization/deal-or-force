// Forty-four further answers to the twenty-two questions the policy workspace already
// asks. Every category below is an existing one; every option is one more answer to it,
// and every answer is a trade, never an upgrade - the rule the shipped files follow.
//
// A `modifiers` block uses the keys in Scripts/Simulation/NationalModifiers.cs; `icon`
// names a sprite without the `icon_` prefix, exactly as the shipped options do. Foreign
// options carry `foreign_trust`, the targeted-posture number, rather than modifiers.
{
  "//": "More options for existing categories: two further answers to each question.",

  "fiscal_war": { "name": "War finance mandate", "category": "Fiscal mandate", "icon": "treasury", "description": "The treasury borrows what the war needs and collects harder while it does.", "modifiers": { "tax_efficiency": 0.04, "borrowing_cost": 0.10, "war_support_weekly": 0.0008 } },
  "fiscal_austerity": { "name": "Austerity", "category": "Fiscal mandate", "icon": "treasury", "description": "Spending cut to what the taxes already cover. Credit thanks the country; the country does not thank it.", "modifiers": { "tax_efficiency": 0.05, "construction_speed": -0.05, "living_weekly": -0.0005 } },

  "service_contract": { "name": "Contract service", "category": "Military service", "icon": "army_defend", "description": "Longer terms and professional pay: formations that fight better and cost more to raise.", "modifiers": { "recruitment_speed": 0.05, "recruitment_cost": 0.10, "army_attack": 0.02 } },
  "service_elite": { "name": "Elite small force", "category": "Military service", "icon": "army_defend", "description": "Fewer divisions, better ones, and no depth behind them: replacements arrive slowly.", "modifiers": { "army_attack": 0.05, "army_defense": 0.04, "recruitment_speed": -0.08, "reinforcement_rate": -0.10 } },

  "education_digital": { "name": "Digital literacy drive", "category": "Education", "icon": "research", "description": "Computers in every school and a generation that speaks to machines - and organises on them.", "modifiers": { "research_speed": 0.06, "tax_efficiency": -0.02, "movement_activity": 0.05 } },
  "education_classical": { "name": "Classical curriculum", "category": "Education", "icon": "research", "description": "Grammar, history and obedience to the textbook. A settled country, not a fast one.", "modifiers": { "stability_weekly": 0.0003, "tax_efficiency": 0.02, "research_speed": -0.02 } },

  "rights_digital": { "name": "Digital rights charter", "category": "Civil rights", "icon": "population", "description": "Privacy of the wire in law. Science moves to where it is safe to think; the state hears less.", "modifiers": { "research_speed": 0.04, "movement_activity": 0.08, "war_support_weekly": -0.0003 } },
  "rights_oversight": { "name": "Security oversight", "category": "Civil rights", "icon": "population", "description": "Courts that answer quickly and quietly. Organisation is harder; so is surprise.", "modifiers": { "movement_activity": -0.12, "radicalism_weekly": -0.0002, "research_speed": -0.02 } },

  "welfare_workfare": { "name": "Workfare", "category": "Social guarantees", "icon": "population", "description": "Support that has to be worked for. More output, and resentment from those counted off the rolls.", "modifiers": { "output": 0.02, "living_weekly": 0.0002, "radicalism_weekly": 0.0003 } },
  "welfare_family": { "name": "Family support", "category": "Social guarantees", "icon": "population", "description": "Grants, leave and housing for households with children. Dear now, demography later.", "modifiers": { "living_weekly": 0.0004, "stability_weekly": 0.0002, "output": -0.02 } },

  "industry_defense": { "name": "Defence industrial base", "category": "Industrial policy", "icon": "construction", "description": "Shells and steel reserved for the state's own orders, whatever the world price.", "modifiers": { "supply": 0.05, "army_attack": 0.02, "trade_reach": -0.05 } },
  "industry_green": { "name": "Green industrial policy", "category": "Industrial policy", "icon": "construction", "description": "Capital rebuilt around what does not burn. Slower, cleaner, steadier.", "modifiers": { "construction_speed": 0.05, "output": -0.02, "living_weekly": 0.0002 } },

  "labour_codetermination": { "name": "Co-determination", "category": "Labour regulation", "icon": "population", "description": "Workers on every board. Decisions take longer and hold better.", "modifiers": { "stability_weekly": 0.0003, "radicalism_weekly": -0.0002, "output": -0.02 } },
  "labour_platform": { "name": "Platform labour rules", "category": "Labour regulation", "icon": "population", "description": "The gig economy in law: cheap, quick, and precariously employed.", "modifiers": { "output": 0.03, "living_weekly": -0.0002, "radicalism_weekly": 0.0005 } },

  "migration_open": { "name": "Open doors", "category": "Migration policy", "icon": "population", "description": "Anyone who arrives and works, stays. A faster country and an angrier argument.", "modifiers": { "research_speed": 0.04, "output": 0.03, "radicalism_weekly": 0.0004 } },
  "migration_diaspora": { "name": "Diaspora engagement", "category": "Migration policy", "icon": "population", "description": "The country's own abroad as a trade network, courted rather than forgotten.", "modifiers": { "trade_reach": 0.06, "research_speed": 0.02, "tax_efficiency": -0.02 } },

  "environment_carbon": { "name": "Carbon pricing", "category": "Environmental regulation", "icon": "construction", "description": "What burns pays for burning. The budget gains, the furnaces grumble.", "modifiers": { "tax_efficiency": 0.05, "output": -0.03, "living_weekly": 0.0002 } },
  "environment_nuclear": { "name": "Nuclear expansion", "category": "Environmental regulation", "icon": "energy", "description": "Reactors on the coast and the river, and the argument that follows them.", "modifiers": { "output": 0.05, "supply": 0.02, "radicalism_weekly": 0.0003 } },

  "security_intelligence": { "name": "Intelligence mandate", "category": "Security mandate", "icon": "decisions", "description": "The quiet service grows. Long-range formations are looked after; letters are read.", "modifiers": { "support_losses": -0.05, "movement_activity": -0.05, "tax_efficiency": -0.03 } },
