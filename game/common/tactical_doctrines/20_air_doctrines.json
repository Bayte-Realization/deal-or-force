        "modifiers": { "support_losses": -0.10 } },
      { "id": "sky_grid", "name": "The interception grid", "requires": ["sky_crews"],
        "description": "Approach lanes are watched from the ground as well as the air.",
        "cost": 16, "days": 130, "rush_cost": 45,
        "modifiers": { "support_losses": -0.06, "army_defense": 0.02 } },
      { "id": "sky_sweep", "name": "Fighter sweeps", "requires": ["sky_crews"],
        "description": "The enemy's aircraft are found over their own airfields, not over ours.",
        "cost": 18, "days": 140, "rush_cost": 50,
        "modifiers": { "support_losses": -0.05 } },
      { "id": "sky_radar", "name": "The radar chain", "requires": ["sky_grid"],
        "description": "A warning that arrives ten minutes early is a different war.",
