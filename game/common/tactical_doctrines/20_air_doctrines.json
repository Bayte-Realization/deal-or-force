// Воздушные уставы: небо над своей армией и небо над чужой промышленностью.
{
  "sky": {
    "name": "Doctrine of the sky",
    "description": "War from above: air formations kept flying, kept whole, and brought to bear over the army.",
    "experience": "air",
    "nodes": [
      { "id": "sky_crews", "name": "Ground crews first",
