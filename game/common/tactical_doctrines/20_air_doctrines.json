        "modifiers": { "army_attack": 0.03, "support_recovery": 0.05 } },
      { "id": "sky_interdiction", "name": "Battlefield interdiction", "requires": ["sky_army_air"],
        "description": "Nothing moves towards the front without being seen and paid for.",
        "cost": 40, "days": 200, "rush_cost": 110,
        "modifiers": { "army_attack": 0.03, "support_recovery": 0.04 } },
      { "id": "sky_command", "name": "Command of the air", "requires": ["sky_interdiction", "sky_radar"],
        "description": "The sky is held, so everything under it is cheaper to defend.",
        "cost": 55, "days": 260, "rush_cost": 150,
        "modifiers": { "support_losses": -0.06, "support_recovery": 0.05, "deterrence": 0.03 } }
    ]
  },
  "strategic_air": {
    "name": "Doctrine of the long reach",
    "description": "War against the enemy's country rather than its army: range, bases and a campaign flown for months.",
    "experience": "air",
    "nodes": [
      { "id": "air_range", "name": "Range first",
        "description": "A bomber that cannot reach the target is a very expensive trainer.",
        "cost": 12, "days": 110, "rush_cost": 35,
        "modifiers": { "support_recovery": 0.06 } },
      { "id": "air_bases", "name": "Bases and ferrying", "requires": ["air_range"],
        "description": "The wing that can move between fields can keep flying after the first week.",
        "cost": 18, "days": 140, "rush_cost": 50,
        "modifiers": { "support_recovery": 0.05, "support_losses": -0.04 } },
      { "id": "air_navigation", "name": "Navigation and weather", "requires": ["air_range"],
        "description": "A campaign is flown in the weather it has, not the weather it wants.",
        "cost": 18, "days": 140, "rush_cost": 50,
        "modifiers": { "support_losses": -0.05 } },
      { "id": "air_industry", "name": "The industrial target", "requires": ["air_bases"],
        "description": "Factories are a target list, and the list is written by economists.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "army_attack": 0.02, "support_recovery": 0.04 } },
      { "id": "air_lines", "name": "Lines of communication", "requires": ["air_navigation"],
        "description": "Rail, road and port: the enemy's army eats what these three carry.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "supply": 0.03, "support_losses": -0.04 } },
      { "id": "air_campaign", "name": "The sustained campaign", "requires": ["air_industry"],
        "description": "A raid is news; a campaign is a season of raids on one industry.",
        "cost": 45, "days": 220, "rush_cost": 125,
        "modifiers": { "army_attack": 0.03, "support_losses": -0.05 } },
      { "id": "air_night", "name": "Night and blind bombing", "requires": ["air_lines"],
        "description": "What cannot be seen can still be found, and the loss rate halves.",
        "cost": 45, "days": 220, "rush_cost": 125,
        "modifiers": { "support_losses": -0.05, "support_recovery": 0.04 } },
      { "id": "air_strangle", "name": "The stranglehold", "requires": ["air_campaign", "air_night"],
        "description": "The enemy's front is starved from four hundred kilometres behind it.",
        "cost": 60, "days": 270, "rush_cost": 160,
        "modifiers": { "support_losses": -0.06, "supply": 0.04 } }
    ]
  }
