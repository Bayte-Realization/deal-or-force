// Сухопутные уставы: оборона своей земли и война числом.
{
  "fortress": {
    "name": "Doctrine of the fortress",
    "description": "War as ground held: entrenchment, reinforcement, and a country that is unpleasant to attack.",
    "experience": "army",
    "nodes": [
      { "id": "fortress_dig", "name": "Digging in",
        "description": "A division standing still is a division building something.",
        "cost": 20, "days": 120, "rush_cost": 55,
        "modifiers": { "entrenchment_speed": 0.12, "army_defense": 0.04 } },
      { "id": "fortress_relief", "name": "The relieved line", "requires": ["fortress_dig"],
        "description": "Replacements reach the trenches on a schedule, and the schedule is kept.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "army_defense": 0.06, "reinforcement_rate": 0.08 } },
      { "id": "fortress_works", "name": "Concrete works", "requires": ["fortress_dig"],
        "description": "The line stops being a ditch and starts being an address.",
        "cost": 25, "days": 150, "rush_cost": 70,
        "modifiers": { "entrenchment_speed": 0.10, "army_defense": 0.05 } },
      { "id": "fortress_zone", "name": "The fortified zone", "requires": ["fortress_works"],
        "description": "One trench is a position; a belt of them is a decision.",
        "cost": 45, "days": 200, "rush_cost": 120,
        "modifiers": { "army_defense": 0.05, "entrenchment_speed": 0.06 } },
      { "id": "fortress_depot", "name": "Forward depots", "requires": ["fortress_relief"],
        "description": "Ammunition kept where the line will need it, not where it was bought.",
        "cost": 40, "days": 190, "rush_cost": 110,
        "modifiers": { "supply": 0.04, "reinforcement_rate": 0.05 } },
      { "id": "fortress_province", "name": "The armed province", "requires": ["fortress_relief"],
        "description": "Every threatened district can raise its own militia, and does.",
        "cost": 55, "days": 240, "rush_cost": 150,
        "modifiers": { "army_defense": 0.05, "militia_readiness": 0.10 } },
      { "id": "fortress_citadel", "name": "The citadel", "requires": ["fortress_zone"],
        "description": "The last line is prepared before the first one is lost.",
        "cost": 70, "days": 260, "rush_cost": 185,
        "modifiers": { "army_defense": 0.06, "militia_readiness": 0.06 } },
      { "id": "fortress_country", "name": "A country in arms", "requires": ["fortress_citadel", "fortress_depot"],
        "description": "Every road a defence, every town a store, every week of the enemy's a bill.",
        "cost": 90, "days": 320, "rush_cost": 240,
        "modifiers": { "army_defense": 0.05, "entrenchment_speed": 0.08, "deterrence": 0.05 } }
    ]
  },
  "levy": {
    "name": "Doctrine of the levy",
    "description": "War as numbers: cheap divisions, replaced as fast as they are lost, supplied by their own country.",
    "experience": "army",
    "nodes": [
      { "id": "levy_district", "name": "Every district a company",
        "description": "Recruiting offices open in places that used to send nobody.",
        "cost": 20, "days": 120, "rush_cost": 55,
        "modifiers": { "recruitment_speed": 0.10, "recruitment_cost": -0.06 } },
      { "id": "levy_reserve", "name": "The standing reserve", "requires": ["levy_district"],
        "description": "The militia knows its stores and its assembly points.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "militia_readiness": 0.12, "reinforcement_rate": 0.08 } },
      { "id": "levy_drill", "name": "The Sunday drill", "requires": ["levy_district"],
        "description": "Men who have held the rifle before hold it steadier the second time.",
        "cost": 25, "days": 150, "rush_cost": 70,
        "modifiers": { "recruitment_speed": 0.06, "organisation_recovery": 0.04 } },
      { "id": "levy_office", "name": "The recruiting office", "requires": ["levy_district"],
        "description": "Paperwork is what stands between a nation and its army.",
        "cost": 35, "days": 180, "rush_cost": 95,
        "modifiers": { "recruitment_speed": 0.06 } },
      { "id": "levy_replacement", "name": "The replacement stream", "requires": ["levy_reserve"],
        "description": "A division is refilled the week it is emptied, not the season.",
        "cost": 45, "days": 200, "rush_cost": 120,
        "modifiers": { "reinforcement_rate": 0.08 } },
      { "id": "levy_mass", "name": "War in mass", "requires": ["levy_office", "levy_drill"],
        "description": "The plan assumes two more armies than the staff has raised.",
        "cost": 65, "days": 250, "rush_cost": 175,
        "modifiers": { "recruitment_cost": -0.05, "militia_readiness": 0.08 } },
      { "id": "levy_land", "name": "Living off the land", "requires": ["levy_reserve"],
        "description": "A marching army is fed from the country it marches through.",
        "cost": 55, "days": 240, "rush_cost": 150,
        "modifiers": { "supply": 0.05, "recruitment_speed": 0.08 } },
      { "id": "levy_nation", "name": "The nation in arms", "requires": ["levy_mass", "levy_land"],
        "description": "Every household has a place in the order of battle, and knows it.",
        "cost": 85, "days": 320, "rush_cost": 230,
        "modifiers": { "recruitment_speed": 0.08, "reinforcement_rate": 0.06, "war_support_weekly": 0.05 } }
    ]
  }
}
