        "modifiers": { "naval_speed": 0.05, "supply": 0.03, "shipbuilding_speed": 0.05 } }
    ]
  },
  "sea_denial": {
    "name": "Doctrine of the undersea",
    "description": "War on the enemy's shipping: boats, packs and a blockade that costs no battle line.",
    "experience": "navy",
    "nodes": [
      { "id": "sub_boats", "name": "The boats",
        "description": "A cheap hull that can be lost is a weapon; a prestige ship that cannot is a hostage.",
        "cost": 12, "days": 110, "rush_cost": 35,
        "modifiers": { "naval_speed": 0.03 } },
      { "id": "sub_patrol", "name": "Patrol lines", "requires": ["sub_boats"],
        "description": "The sea is divided into beats, and every beat is somebody's.",
        "cost": 18, "days": 140, "rush_cost": 50,
        "modifiers": { "naval_speed": 0.04, "supply": 0.02 } },
      { "id": "sub_pack", "name": "The pack", "requires": ["sub_boats"],
        "description": "One boat finds the convoy; the others are told where it is.",
        "cost": 18, "days": 140, "rush_cost": 50,
        "modifiers": { "naval_speed": 0.03, "deterrence": 0.02 } },
      { "id": "sub_convoy_war", "name": "War on shipping", "requires": ["sub_patrol"],
        "description": "The target is tonnage, not warships.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "supply": 0.04 } },
      { "id": "sub_training", "name": "The training flotilla", "requires": ["sub_pack"],
        "description": "Crews are made in the Baltic before they are needed in the Atlantic.",
        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "naval_speed": 0.04, "shipbuilding_speed": 0.04 } },
      { "id": "sub_blockade", "name": "The blockade", "requires": ["sub_convoy_war"],
