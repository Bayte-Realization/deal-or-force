        "modifiers": { "shipbuilding_speed": 0.08, "naval_speed": 0.03 } },
      { "id": "coast_command", "name": "Command of the sea", "requires": ["coast_shore", "coast_bases"],
        "description": "Trade arrives because the water is ours, and the enemy plans around it.",
