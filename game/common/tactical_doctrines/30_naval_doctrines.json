        "cost": 45, "days": 220, "rush_cost": 125,
        "modifiers": { "supply": 0.04, "deterrence": 0.03 } },
      { "id": "sub_yards", "name": "Boats from yards", "requires": ["sub_training"],
        "description": "Sections built indoors, launched in weeks, replaced the same season.",
