        "modifiers": { "shipbuilding_speed": 0.08 } },
      { "id": "sub_command", "name": "The undersea command", "requires": ["sub_blockade", "sub_yards"],
        "description": "An admiral who never sees the enemy and still decides the war.",
        "cost": 60, "days": 270, "rush_cost": 160,
        "modifiers": { "naval_speed": 0.05, "supply": 0.04, "shipbuilding_speed": 0.05 } }
    ]
