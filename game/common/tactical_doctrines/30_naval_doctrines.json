        "modifiers": { "naval_speed": 0.05, "supply": 0.03 } },
      { "id": "coast_bases", "name": "The chain of bases", "requires": ["coast_yards"],
        "description": "A fleet is its harbours: fuel, docks and a dry berth between them.",
