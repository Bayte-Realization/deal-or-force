// Морские уставы: надводный флот, что держит море, и подводные лодки, что его закрывают.
{
  "coast": {
    "name": "Doctrine of the coast",
    "description": "War from the sea: fleets that sail on time, yards that finish hulls, and a coast that supplies itself.",
    "experience": "navy",
    "nodes": [
      { "id": "coast_patrol", "name": "Standing patrols",
