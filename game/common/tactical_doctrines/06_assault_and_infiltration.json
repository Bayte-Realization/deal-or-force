// Сухопутные уставы удара: броня в проломе и пехота, которая входит в чужие окопы.
{
  "shock": {
    "name": "Doctrine of the shock",
    "description": "War as one blow in one place: armour, concentration and pursuit, with nothing held back for the second day.",
    "experience": "army",
    "nodes": [
      { "id": "shock_punch", "name": "The punch",
        "description": "One narrow sector is worth more than the whole line.",
        "cost": 25, "days": 140, "rush_cost": 70,
        "modifiers": { "army_attack": 0.06 } },
      { "id": "shock_concentration", "name": "Concentration", "requires": ["shock_punch"],
        "description": "Artillery, armour and infantry on the same kilometre on the same morning.",
        "cost": 35, "days": 180, "rush_cost": 95,
        "modifiers": { "army_attack": 0.05, "supply": 0.02 } },
      { "id": "shock_mobile", "name": "The mobile reserve", "requires": ["shock_punch"],
        "description": "The exploitation is planned before the breakthrough exists.",
        "cost": 35, "days": 180, "rush_cost": 95,
        "modifiers": { "army_speed": 0.05, "army_attack": 0.03 } },
      { "id": "shock_breakthrough", "name": "Breaking the line", "requires": ["shock_concentration"],
        "description": "A doctrine of the gap, and of what happens in the hour after it opens.",
        "cost": 50, "days": 220, "rush_cost": 135,
        "modifiers": { "army_attack": 0.05, "organisation_recovery": 0.03 } },
      { "id": "shock_exploit", "name": "Exploitation", "requires": ["shock_mobile"],
        "description": "The enemy's rear is treated as the objective, not the reward.",
        "cost": 50, "days": 220, "rush_cost": 135,
        "modifiers": { "army_speed": 0.05, "army_attack": 0.04 } },
      { "id": "shock_combined", "name": "Combined arms", "requires": ["shock_breakthrough"],
        "description": "Armour never fights alone, and never waits for the infantry it outran.",
        "cost": 65, "days": 260, "rush_cost": 175,
        "modifiers": { "army_attack": 0.04, "army_defense": 0.03, "support_recovery": 0.03 } },
      { "id": "shock_pursuit", "name": "The pursuit", "requires": ["shock_exploit"],
        "description": "The most expensive thing an army can do is let a beaten enemy walk away.",
        "cost": 65, "days": 260, "rush_cost": 175,
        "modifiers": { "army_speed": 0.06, "army_attack": 0.03 } },
      { "id": "shock_decision", "name": "The decision", "requires": ["shock_combined", "shock_pursuit"],
        "description": "One campaign, one week, one battle that ends the war's argument.",
        "cost": 85, "days": 320, "rush_cost": 230,
        "modifiers": { "army_attack": 0.06, "army_speed": 0.04 } }
    ]
  },
  "infiltration": {
    "name": "Doctrine of infiltration",
    "description": "War from inside the enemy's position: patrols, storm parties and small units that own the ground they stand on.",
    "experience": "army",
    "nodes": [
      { "id": "inf_patrols", "name": "Standing patrols",
        "description": "The ground in front of the line is known before it is crossed.",
        "cost": 22, "days": 130, "rush_cost": 60,
        "modifiers": { "army_defense": 0.04, "entrenchment_speed": 0.06 } },
      { "id": "inf_storm", "name": "Storm parties", "requires": ["inf_patrols"],
        "description": "Small groups sent to take one trench, not the line.",
        "cost": 32, "days": 170, "rush_cost": 90,
        "modifiers": { "army_attack": 0.05 } },
      { "id": "inf_night", "name": "Night work", "requires": ["inf_patrols"],
        "description": "An attack that the enemy's artillery cannot see is an attack worth making.",
        "cost": 32, "days": 170, "rush_cost": 90,
        "modifiers": { "army_attack": 0.03, "army_defense": 0.03 } },
      { "id": "inf_engineers", "name": "Assault engineers", "requires": ["inf_storm"],
        "description": "Wire, bunkers and minefields are a trade, and the trade can be taught.",
        "cost": 45, "days": 200, "rush_cost": 120,
        "modifiers": { "army_attack": 0.04, "entrenchment_speed": 0.05 } },
      { "id": "inf_small_units", "name": "The small unit", "requires": ["inf_night"],
        "description": "A section that knows its own job needs no order from the rear.",
        "cost": 45, "days": 200, "rush_cost": 120,
        "modifiers": { "army_defense": 0.05, "organisation_recovery": 0.03 } },
      { "id": "inf_assault", "name": "The deliberate assault", "requires": ["inf_engineers"],
        "description": "A position is taken by people who rehearsed taking it.",
        "cost": 60, "days": 250, "rush_cost": 165,
        "modifiers": { "army_attack": 0.05, "support_losses": -0.03 } },
      { "id": "inf_hold", "name": "Holding what was taken", "requires": ["inf_small_units"],
        "description": "The counter-attack arrives at a position that is already organised.",
        "cost": 60, "days": 250, "rush_cost": 165,
        "modifiers": { "army_defense": 0.05, "reinforcement_rate": 0.05 } },
      { "id": "inf_mastery", "name": "The infantry's war", "requires": ["inf_assault", "inf_hold"],
        "description": "Ground is taken and kept by the men on it, and the book finally says so.",
        "cost": 80, "days": 310, "rush_cost": 220,
        "modifiers": { "army_attack": 0.05, "army_defense": 0.04, "organisation_recovery": 0.04 } }
    ]
  }
}
