        "cost": 30, "days": 180, "rush_cost": 85,
        "modifiers": { "army_speed": 0.05, "army_attack": 0.04 } },
      { "id": "manoeuvre_screen", "name": "The horse screen", "requires": ["manoeuvre_march"],
        "description": "Screens that find the enemy before the enemy finds the columns.",
        "cost": 25, "days": 150, "rush_cost": 70,
        "modifiers": { "army_speed": 0.04, "supply": 0.03 } },
      { "id": "manoeuvre_free_hand", "name": "The free hand", "requires": ["manoeuvre_columns"],
