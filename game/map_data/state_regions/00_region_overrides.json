  "partitions": [
    {
      // Hebei wraps around Beijing and Tianjin, which are carved out of it in reality, so
      // it draws as a crescent. Splitting the whole province into prefectures fixed the
      // crescent and cost more than it was worth: the province stopped being called Hebei
      // at all. Only the two arms come off - the northern one behind Beijing and the
      // north-eastern one along the Chengde hills - and the body of the province keeps its
      // name and most of its people.
      //
      // The shares grow out of their capitals and meet where they meet, so no border here
      // is a line of latitude. A share that ends up holding ground it cannot walk to gives
      // that scrap to whichever region it touches most, which is what becomes of the
      // fragment east of Beijing.
      "nation": "CHN",
      "carve_from_iso": "CN-HE",
      "pieces": [
        { "map_index": 1099, "name": "Hebei", "iso": "CN-HE", "kind": "Province",
          "population": 46030000, "seed": [115.95, 37.85] },
        { "map_index": 1721, "name": "Zhangjiakou", "iso": "CN-HE-ZJK", "kind": "Prefecture",
          "population": 4120000, "seed": [114.89, 40.82] },
        { "map_index": 1722, "name": "Chengde", "iso": "CN-HE-CDE", "kind": "Prefecture",
          "population": 3350000, "seed": [117.94, 41.00] }
      ]
    },
    {
      // Antarctica was one region of nine thousand provinces, so the first country to plant a
      // flag on it had a continent. It is the lands its coasts are named for - Queen Maud Land,
      // Wilkes Land, Victoria Land, Marie Byrd Land, the peninsula's Graham and Palmer Lands -
      // the two great ice shelves, and the high plateau behind them, where Vostok and Kunlun
      // stand and the Pole is. Each is settled on its own.
      //
      // "polar" grows the shares on the ground rather than on the raster (see GrowPolar): near
      // the pole a cell is a sliver, and grown a cell a step the borders came out as the spokes
      // and rings of a dartboard. The islands of the old "Region 2549", a hundred and fifty
      // specks off every coast, go to whichever land they lie off; the region keeps its index
      // as Graham Land.
      "nation": "ATA",
      "carve_from_iso": "AQ-X01~",
      "also_carve_from_iso": ["AQ-X02~"],
      "polar": true,
