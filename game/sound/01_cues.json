// Every moment the game has a sound for.
//
// The code names the moment; this file says what it sounds like and how it behaves. A
// mod replacing one sound writes `"war_declared": "audio/mine.wav"` and inherits the
// timing; a mod that wants the battle report to come round twice as often changes
// cooldown_ms and inherits the file.
//
// Paths are relative to this `sound/` folder, the same way a path in gfx/00_sprites.json
// is relative to `gfx/`. That is new: they used to be relative to the project root and the
// recordings themselves lived in `Assets/Audio`, beside the source code - which made the
// sound of this game the one kind of content a mod could not reach without knowing where
// the executable had been built from. They live in `sound/audio` now, inside the data.
//
// cooldown_ms  - how long before this cue may sound again.
// yields_to_anything_playing - true for cues that arrive in batches, so a hundred
//                              resolved battles never talk over a peace being signed.
{
  "cues": {
    "war_declared": {
      "file": "audio/war_declared.wav",
      "channel": "strategic",
      "cooldown_ms": 900
    },
    "peace_signed": {
      "file": "audio/peace_signed.wav",
      "channel": "strategic",
      "cooldown_ms": 900
    },
    "event_alert": {
      "file": "audio/event_alert.wav",
      "channel": "strategic",
      "cooldown_ms": 900
    },
    "battle_won": {
      "file": "audio/battle_won.wav",
      "channel": "battle",
      "cooldown_ms": 4500,
      "yields_to_anything_playing": true
    },
    "battle_lost": {
      "file": "audio/battle_lost.wav",
      "channel": "battle",
      "cooldown_ms": 4500,
      "yields_to_anything_playing": true
    },
    "ui_select": {
      "file": "audio/ui_select.wav",
      "channel": "interface",
      "cooldown_ms": 80
    }
  }
}
