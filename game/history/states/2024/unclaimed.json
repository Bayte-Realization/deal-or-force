  // network that joins them to Cape Town. Claimed by Norway.
  "aq_qml": {
    "owner": "none",
    "population": 0,
    "urbanization": 0.0,
    "claims": ["NOR"],
    "buildings": {"ResearchLab": 2, "Infrastructure": 2},
