// Land nobody owns on 1 January 2024.
//
// "owner": "none" makes a region belong to nobody: its provinces stay unowned whatever the
// map painted there, it is drawn in the grey of land no flag flies over, and any country that
// can reach it - over a border of its own or, when it is coastal, by sea from a coast of its
// own - may settle it (ColonisationCore). "none" is the only owner a region takes; who owns
// a province is otherwise history/provinces/ownership.csv. A colonial-era scenario would list
// its unclaimed regions here the same way.
{
  // Antarctica - held by no state under the 1959 Antarctic Treaty; nobody lives there for good.
  //
  // Seventeen lands, each settled on its own (ColonisationCore). "claims" are the seven
  // claimants' sectors, frozen by the Treaty's fourth article: whoever settles a land somebody
  // else claims makes an enemy of the claimant, and a claimant settles its own for less.
  // Buildings are the stations; what is under the ice is what the geology says is there.
  // Polar Plateau - the high ice behind the Transantarctic Mountains, and the Pole. Amundsen-Scott
  // (USA) at the Pole; the coal of the Beardmore Glacier and the chromium and platinum of the
  // Dufek Massif under the ice. Every claimant's sector meets here.
  "aq_x01": {
    "owner": "none",
    "population": 0,
    "urbanization": 0.0,
    "claims": ["NOR", "AUS", "NZL", "CHL", "ARG", "GBR"],
    "buildings": {"ResearchLab": 1, "Infrastructure": 1},
    "resources": { "Food": 0.0, "Coal": 2.0, "Oil": 0.0, "IronOre": 0.3, "RareEarths": 1.2, "NaturalGas": 0.0, "Timber": 0.0, "Bauxite": 0.0, "Uranium": 0.0 }
  },
