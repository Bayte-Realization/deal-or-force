// Wallis and Futuna (WLF) on 1 January 2024: 1 region, 11,558 people.
//
// Every region the country holds when the bookmark opens, and what it has: how many people
// live there and how many of them in towns, who they are, what is built there and what lies
// under the ground. "A region's first day" in docs/MODDING_GUIDE.md lists every field.
//
// What is written is what the region has - a building or a deposit left out is not there.
// A field left out altogether is worked out from the country, the way it is for a region a
// mod adds. Files are read in name order and a later one naming the same region wins key by
// key, so a mod that changes one number writes that one number and inherits the rest.
// Who owns a province is history/provinces/ownership.csv; the file a region is in is only
// where to find it.
{
  // Uvea
  "wf_uv": {
    "population": 11558,
    "urbanization": 0.454,
    "cultures": { "polynesian": 0.94, "french": 0.04, "kanak": 0.02 },
    "buildings": { "Agriculture": 1, "Infrastructure": 1 },
    "resources": { "Food": 1.769, "Coal": 0.197, "Oil": 0.301, "IronOre": 0.266, "RareEarths": 0.075, "NaturalGas": 0.486, "Timber": 1.285, "Bauxite": 0.066, "Uranium": 0.006 }
  }
}
