  "kz_sev": {"claims": ["RUS"]}, "kz_pav": {"claims": ["RUS"]}, "kz_vos": {"claims": ["RUS"]},
  "kz_akm": {"claims": ["RUS"]}, "kz_kus": {"claims": ["RUS"]},
  "md_si": {"claims": ["ROU"]},
  "md_or": {"claims": ["ROU"]}
