    "cultures": { "slovene": 0.8872, "serbian": 0.0426, "bosniak": 0.0255, "croatian": 0.0213, "albanian": 0.0074, "hungarian": 0.0053, "macedonian": 0.0053, "montenegrin": 0.0032, "italian": 0.0021 },
    "buildings": { "Agriculture": 1, "Infrastructure": 2 },
