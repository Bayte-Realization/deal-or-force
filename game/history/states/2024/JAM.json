  "jm_13": {
    "population": 2948279,
    "urbanization": 0.478,
    "cultures": { "jamaican": 0.92, "haitian": 0.02, "indian_diaspora": 0.02, "american": 0.015, "english": 0.015, "chinese_diaspora": 0.01 },
    "buildings": { "Agriculture": 1, "Infrastructure": 1 },
    "resources": { "Food": 1.283, "Coal": 0.337, "Oil": 0.322, "IronOre": 0.151, "RareEarths": 0.052, "NaturalGas": 0.275, "Timber": 2.097, "Bauxite": 3.739, "Uranium": 0.005 }
