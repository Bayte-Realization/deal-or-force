// Palestine (PSE) on 1 January 2024: 1 region, 2,585,306 people.
//
// Every region the country holds when the bookmark opens, and what it has: how many people
// live there and how many of them in towns, who they are, what is built there and what lies
// under the ground. "A region's first day" in docs/MODDING_GUIDE.md lists every field.
//
// What is written is what the region has - a building or a deposit left out is not there.
// A field left out altogether is worked out from the country, the way it is for a region a
// mod adds. Files are read in name order and a later one naming the same region wins key by
// key, so a mod that changes one number writes that one number and inherits the rest.
// Who owns a province is history/provinces/ownership.csv; the file a region is in is only
// where to find it.
{
  // West Bank.
  "ps_wbk": {
    "population": 2585306,
    "urbanization": 0.784,
    "cultures": { "palestinian": 0.96, "bedouin": 0.025, "israeli_jew": 0.01, "armenian": 0.003, "assyrian": 0.002 },
    "buildings": { "Agriculture": 1, "Infrastructure": 3 },
    "resources": { "Food": 1.405, "Coal": 0.097, "Oil": 0.182, "IronOre": 0.111, "RareEarths": 0.038, "NaturalGas": 0.201, "Timber": 1.18, "Bauxite": 0.023, "Uranium": 0.006 }
  },
  // The Gaza Strip - Israel's in this bookmark, not Palestine's: it is written here because
  // it is Palestinian ground, but ownership.csv gives its province to Israel, the way the
  // Russian-held regions of Ukraine are Russia's. A stopgap until the game can say what
  // the Strip actually is. Almost all of it town; the Gaza Marine gas field lies off its coast.
  //
  // No "war_damage" here, though there is every reason for one: a wrecked region sends its
  // people to its neighbours at peace, Egypt is by far the largest of them, and fifteen years
  // of refugees in the Nile valley made the secession rules raise a "Palestine" out of five
  // Egyptian regions and twenty-seven million Egyptians. Until a secession asks who the people
  // of a region mostly are, the damage stays out.
  "ps_gza": {
    "population": 2100000,
    "urbanization": 0.82,
    "cultures": { "palestinian": 0.995, "arab_levantine": 0.005 },
    "buildings": { "Infrastructure": 1 },
    "resources": { "Food": 0.35, "NaturalGas": 0.6 }
  }
}
