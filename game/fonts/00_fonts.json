// The typeface the interface is set in.
//
// Globality Atlas typography: restrained sans-serif UI and tracked serif country names.
// The UI retains Godot's multilingual default. The map requests an installed serif with
// Cyrillic coverage; the engine falls back if none is installed. These are existing typefaces,
// not an original font file. A mod can bundle its licensed font and set the file role below.
//
//   {
//     "fonts": {
//       "ui.default": "fonts/NotoSansSC-Regular.ttf"
//     }
//   }
//
// Roles: ui.default and map.countries. File paths override system_families when available.
{
  "fonts": {
    "map.countries": { "system_families": ["Georgia", "Noto Serif", "Liberation Serif"] }
  }
}
