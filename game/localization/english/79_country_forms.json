// What a country is called once its politics have changed.
//
// The machinery lives in CountryNames: the exact key
// `country.<TAG>.<government|ideology>.<value>.name` is asked first, then the general
// `name.form.*` template, then the country's plain name. Only the cases where the name is
// genuinely different are written here - the ones where the template would produce
// "People's Republic of France".
{
  "country.RUS.ideology.communism.name": "Russian Soviet Republic",
  "country.RUS.government.absolute_monarchy.name": "Russian Empire",
  "country.RUS.government.constitutional_monarchy.name": "Russian Empire",
