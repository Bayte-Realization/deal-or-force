// Deal or Force - the credits screen and the mark in the corner.
//
// `brand.title` is a key rather than an English sentence on purpose: the game's name
// is the same name in every language, and keying it by its own text would invite a
// translator to translate it. A mod renaming the game changes this one row.
{
  "Credits": "Credits",
  "brand.title": "Deal or Force",
  "© {0} Bayte Realization": "© {0} Bayte Realization",
  "Made by": "Made by",
  "Bayte Realization (Kamil Suleymanov)": "Bayte Realization (Kamil Suleymanov)",
  "With the explicit use of AI": "With the explicit use of AI"
}
