// Every icon the interface asks for by name.
//
// The name on the left is what the code says; the path on the right is what it gets. A
// mod that wants its own iconography drops 50_my_icons.json beside this file, lists only
// the names it is replacing, and inherits the rest - and its paths are found inside the
// mod's own folder, so it ships the art next to the declaration.
{
  "sprites": {
    "icon_army_advance": "Assets/Textures/UI/Modern/Icons/army_advance.svg",
