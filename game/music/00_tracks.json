// The soundtrack.
//
// Four tracks of the game's own (audio/README.md says where they came from), and the easiest
// list in the game to change: a mod drops its own files in and names them here - under a key
// of its own to add a track, under one of these to replace it.
//
//   {
//     "tracks": {
//       "menu_theme": { "file": "audio/theme.ogg", "weight": 2, "when": "menu" },
//       "cold_front": { "file": "audio/front.ogg", "when": "campaign" }
//     }
//   }
//
// when    - "menu", "campaign", or "any" (the default).
// weight  - how often it comes round relative to the others. One by default.
{
  "tracks": {
    "menu_theme": { "file": "audio/menu_theme.ogg", "weight": 2, "when": "menu" },
    "campaign_ambient": { "file": "audio/campaign_ambient.ogg", "weight": 3, "when": "campaign" },
    "war_theme": { "file": "audio/war_theme.ogg", "weight": 2, "when": "campaign" },
    "victory_theme": { "file": "audio/victory_theme.ogg", "weight": 1, "when": "campaign" }
  }
}
