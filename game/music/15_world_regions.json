// The world-regions score of 20-21 October: a calm and a tense piece for each part of the
// world that had no music of its own, a war underscore for everyone, and the menu's signature
// theme. Generated through Creative Claw (Lyria 3.5) and levelled to -19 LUFS like the rest.
//
// A region tag is a continent ("europe", "africa", "oceania"), a sub-region of the country
// table ("western_asia", "central_asia", "caribbean") or a country's own tag ("irn"); spaces
// and hyphens read as underscores. The most specific tag wins: a country in Western Asia
// hears the Middle East, not the continent's East Asian companions, and falls back to them
// only for a mood its sub-region has no track for. Iran is Southern Asia in the table and
// Middle Eastern in music, so it is named by tag. Untagged tracks still play everywhere.
{
  "tracks": {
    "menu_theme_atlas": {
      "file": "audio/menu_theme_atlas.ogg", "label": "Turning the globe",
      "when": "menu", "weight": 3, "volume_db": 0
    },
    "world_war": {
      "file": "audio/world_war.ogg", "label": "Arrows on the map",
      "when": "campaign", "moods": ["war"], "weight": 2, "volume_db": 0
    },
    "europe_calm": {
      "file": "audio/europe_calm.ogg", "label": "Morning papers",
      "when": "campaign", "moods": ["calm"], "regions": ["europe"], "weight": 3, "volume_db": 0
    },
    "europe_tense": {
