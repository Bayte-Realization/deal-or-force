+def _strip_required_meta(node):
+    # 4.8 marks non-null object arguments and results with "meta": "required". This
+    # godot-cpp predates RequiredParam/RequiredResult; the ABI is the plain object pointer.
+    if isinstance(node, dict):
+        if node.get("meta") == "required":
+            del node["meta"]
+        for value in node.values():
+            _strip_required_meta(value)
+    elif isinstance(node, list):
+        for value in node:
+            _strip_required_meta(value)
+
+
 def _generate_bindings(api, use_template_get_node, bits="64", precision="single", output_dir="."):
+    _strip_required_meta(api)
