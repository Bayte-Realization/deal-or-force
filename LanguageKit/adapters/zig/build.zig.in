const std = @import("std");
const gdzig = @import("gdzig");

pub fn build(b: *std.Build) !void {
    const target = b.standardTargetOptions(.{});
    const optimize = b.standardOptimizeOption(.{});
    const dep = b.dependency("gdzig", .{
        .target = target,
        .optimize = optimize,
        .@"godot-path" = b.option([]const u8, "godot-path", "Exact Godot executable"),
    });
    const mod = b.createModule(.{
        .root_source_file = b.path("src/extension.zig"),
        .target = target,
        .optimize = optimize,
        .imports = &.{.{ .name = "godot", .module = dep.module("gdzig") }},
    });
    const extension = gdzig.addExtension(b, .{
        .name = "dof_zig", .root_module = mod,
        .entry_symbol = "dof_zig_init", .target = target, .optimize = optimize,
    }) orelse return;
    const install = b.addInstallFileWithDir(extension.output, .{ .custom = "../project/addons/dof_zig" }, extension.filename);
    b.default_step.dependOn(&install.step);
}
